                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>fail-on-common-war-contents</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/war-audit"/>
                                        <mkdir dir="${project.build.directory}/war-audit"/>
                                        <unzip src="${project.build.directory}/${project.build.finalName}.war"
                                               dest="${project.build.directory}/war-audit"/>
                                        <fileset id="forbiddenCommonJar"
                                                 dir="${project.build.directory}/war-audit/WEB-INF/lib"
                                                 includes="opendolphin-common-*.jar"/>
                                        <fileset id="forbiddenCommonClasses"
                                                 dir="${project.build.directory}/war-audit/WEB-INF/classes"
                                                 includes="open/dolphin/common/Orca*.class"/>
                                        <resourcecount property="forbiddenCommonJarCount" refid="forbiddenCommonJar"/>
                                        <resourcecount property="forbiddenCommonClassCount" refid="forbiddenCommonClasses"/>
                                        <condition property="hasForbiddenCommonJar">
                                            <not>
                                                <equals arg1="${forbiddenCommonJarCount}" arg2="0"/>
                                            </not>
                                        </condition>
                                        <condition property="hasForbiddenCommonClass">
                                            <not>
                                                <equals arg1="${forbiddenCommonClassCount}" arg2="0"/>
                                            </not>
                                        </condition>
                                        <fail if="hasForbiddenCommonJar"
                                              message="WAR must not contain opendolphin-common jars"/>
                                        <fail if="hasForbiddenCommonClass"
                                              message="WAR must not contain legacy open.dolphin.common Orca classes"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
