    <build>
        <finalName>opendolphin-server</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}/reporting/templates</directory>
                <targetPath>reporting/templates</targetPath>
                <includes>
                    <include>**/*.vm</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/reporting/glossary</directory>
                <targetPath>reporting/glossary</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-generated-flyway-migrations</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.outputDirectory}/db/migration"/>
                                <mkdir dir="${project.build.outputDirectory}/db/migration"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-ci-contract-checks</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="bash" failonerror="true" dir="${maven.multiModuleProjectDirectory}">
                                    <arg value="server-modernized/tools/ci/check-doc-links.sh"/>
                                </exec>
                                <exec executable="bash" failonerror="true" dir="${maven.multiModuleProjectDirectory}">
                                    <arg value="server-modernized/tools/ci/check-config-contract.sh"/>
                                </exec>
                                <exec executable="bash" failonerror="true" dir="${maven.multiModuleProjectDirectory}">
                                    <arg value="server-modernized/tools/ci/check-no-direct-runtime-lookup.sh"/>
                                </exec>
                                <exec executable="bash" failonerror="true" dir="${maven.multiModuleProjectDirectory}">
                                    <arg value="server-modernized/tools/ci/check-no-runtime-ddl.sh"/>
                                </exec>
                                <exec executable="bash" failonerror="true" dir="${maven.multiModuleProjectDirectory}">
                                    <arg value="server-modernized/tools/ci/check-persistence-entities.sh"/>
                                </exec>
                                <exec executable="bash" failonerror="true" dir="${maven.multiModuleProjectDirectory}">
                                    <arg value="server-modernized/tools/ci/check-no-generated-artifacts.sh"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-canonical-flyway-migrations</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/tools/flyway/sql</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>V*.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <showDeprecation>true</showDeprecation>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/AdmConverterSnapshotTest.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <adm.snapshot.fixtureDir>${project.basedir}/src/test/resources/fixtures/adm</adm.snapshot.fixtureDir>
                        <adm.snapshot.outputDir>${project.build.directory}/adm-snapshots</adm.snapshot.outputDir>
                        <net.bytebuddy.experimental>true</net.bytebuddy.experimental>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*ITCase.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <adm.snapshot.fixtureDir>${project.basedir}/src/test/resources/fixtures/adm</adm.snapshot.fixtureDir>
                        <adm.snapshot.outputDir>${project.build.directory}/adm-snapshots</adm.snapshot.outputDir>
                        <net.bytebuddy.experimental>true</net.bytebuddy.experimental>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>4.2.0.Final</version>
                <configuration>
                    <hostname>${wildfly.hostname}</hostname>
                    <port>${wildfly.port}</port>
                    <serverId>${wildfly.serverId}</serverId>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dev</id>
        </profile>
        <profile>
            <id>prod</id>
        </profile>
        <profile>
            <id>static-analysis</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <spotbugs.plugin.version>4.9.8.2</spotbugs.plugin.version>
                <findsecbugs.plugin.version>1.12.0</findsecbugs.plugin.version>
                <checkstyle.plugin.version>3.3.1</checkstyle.plugin.version>
                <checkstyle.version>10.12.4</checkstyle.version>
                <pmd.plugin.version>3.21.0</pmd.plugin.version>
                <pmd.version>6.55.0</pmd.version>
                <spotbugs.skip>false</spotbugs.skip>
                <static.analysis.config.dir>${maven.multiModuleProjectDirectory}/server-modernized/config/static-analysis</static.analysis.config.dir>
                <static.analysis.output.dir>${maven.multiModuleProjectDirectory}/server-modernized/target/static-analysis</static.analysis.output.dir>
                <static.analysis.enforce>true</static.analysis.enforce>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-static-analysis-dirs</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${static.analysis.output.dir}/spotbugs"/>
                                        <mkdir dir="${static.analysis.output.dir}/checkstyle"/>
                                        <mkdir dir="${static.analysis.output.dir}/pmd"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>${spotbugs.plugin.version}</version>
                        <configuration>
                            <skip>${spotbugs.skip}</skip>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <failOnError>${static.analysis.enforce}</failOnError>
                            <includeTests>false</includeTests>
                            <excludeFilterFile>${static.analysis.config.dir}/spotbugs-exclude.xml</excludeFilterFile>
                            <xmlOutput>true</xmlOutput>
                            <xmlOutputDirectory>${static.analysis.output.dir}/spotbugs</xmlOutputDirectory>
                            <spotbugsXmlOutputDirectory>${static.analysis.output.dir}/spotbugs</spotbugsXmlOutputDirectory>
                            <spotbugsXmlOutputFilename>spotbugs-${project.artifactId}.xml</spotbugsXmlOutputFilename>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs-analyze</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>spotbugs</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>spotbugs-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.plugin.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <version>${checkstyle.plugin.version}</version>
                        <configuration>
                            <skip>true</skip>
                            <configLocation>${static.analysis.config.dir}/checkstyle.xml</configLocation>
                            <includeTestSourceDirectory>false</includeTestSourceDirectory>
                            <failOnViolation>${static.analysis.enforce}</failOnViolation>
                            <linkXRef>false</linkXRef>
                            <outputFile>${static.analysis.output.dir}/checkstyle/checkstyle-${project.artifactId}.xml</outputFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>checkstyle-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>checkstyle</goal>
                                </goals>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>com.puppycrawl.tools</groupId>
                                <artifactId>checkstyle</artifactId>
                                <version>${checkstyle.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <version>${pmd.plugin.version}</version>
                        <configuration>
                            <skip>true</skip>
                            <targetJdk>17</targetJdk>
                            <linkXRef>false</linkXRef>
                            <failOnViolation>${static.analysis.enforce}</failOnViolation>
                            <rulesets>
                                <ruleset>${static.analysis.config.dir}/pmd-ruleset.xml</ruleset>
                            </rulesets>
                            <targetDirectory>${static.analysis.output.dir}/pmd</targetDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pmd-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pmd</goal>
                                </goals>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>net.sourceforge.pmd</groupId>
                                <artifactId>pmd-java</artifactId>
                                <version>${pmd.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dependency-hygiene</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <configuration>
                            <failOnWarning>true</failOnWarning>
                            <ignoredUnusedDeclaredDependencies>
