# Typed config namespace:
# - jboss.server.data.dir => JBOSS_SERVER_DATA_DIR
# - opendolphin.* => OPENDOLPHIN_*
# - orca.* => ORCA_*
# - orca.credentials.* => ORCA_CREDENTIALS_*
# - db.* => DB_*
# - orca.db.* => ORCA_DB_*
# - attachment.storage.* => ATTACHMENT_STORAGE_*
# - document.integrity.* => DOCUMENT_INTEGRITY_*
# - factor2.* => FACTOR2_*
# - plivo.* => PLIVO_*

# PostgreSQL 接続設定 (Secrets 管理対象)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=opendolphin
DB_USER=opendolphin
DB_PASSWORD=change-me
# ↑ 本番環境では Vault/Secrets Manager から注入されるランダムな資格情報を使用する。未更新のまま適用すると接続拒否または監査指摘対象となるため必ず上書きすること。
DB_SSLMODE=verify-full
# DB_SSLROOTCERT には PEM 形式の CA 証明書パスを指定し、必要に応じて docker-compose でマウントする
DB_SSLROOTCERT=/opt/jboss/ssl/root-ca.pem

# ORCA DB 接続設定 (ORCA 専用の Secrets を優先。未設定の場合は DB_* をフォールバック)
ORCA_DB_HOST=
ORCA_DB_PORT=
ORCA_DB_NAME=
ORCA_DB_USER=
ORCA_DB_PASSWORD=
ORCA_DB_SSLMODE=
ORCA_DB_SSLROOTCERT=
# 監査メタ情報 (任意)
ORCA_DB_SECRET_REF=
ORCA_DB_SECRET_VERSION=

# ORCA API (HTTP) 接続設定
# resolver keys: orca.base-url / orca.mode / orca.api.*
ORCA_API_HOST=
ORCA_API_PORT=
ORCA_API_SCHEME=http
ORCA_API_USER=
ORCA_API_PASSWORD=
# ORCA API ベースURL (例: https://orca-trial.example.invalid)
ORCA_BASE_URL=
# ORCA_MODE: weborca / onprem
ORCA_MODE=
# ORCA Cloud などで /api 配下に ORCA API がある場合に指定（例: /api）
ORCA_API_PATH_PREFIX=
# WebORCA を強制指定する場合に true（host が weborca-* の場合は自動判定）
ORCA_API_WEBORCA=
# 旧 ORCA tensu / claim 補助設定。必要な互換補完は廃止し、使う場合だけ明示投入する。
ORCA_FACILITY_JMARI_CODE=
ORCA_FACILITY_HEALTHCAREFACILITY_CODE=
# ORCA_RP_DEFAULT_INOUT: in / out
ORCA_RP_DEFAULT_INOUT=out
# リトライ設定（必要な場合のみ。0 なら無効）
ORCA_API_RETRY_MAX=0
ORCA_API_RETRY_BACKOFF_MS=200
# HTTP transport 詳細設定（必要時のみ。未設定時は safe default を使用）
ORCA_API_RETRY_NETWORK_MAX=3
ORCA_API_RETRY_TRANSIENT_MAX=2
ORCA_API_RETRY_NETWORK_BACKOFF_MS=250
ORCA_API_RETRY_TRANSIENT_BACKOFF_MS=150
ORCA_API_CONNECT_TIMEOUT_MS=5000
ORCA_API_READ_TIMEOUT_MS=15000
ORCA_API_TOTAL_TIMEOUT_MS=30000
# ORCA_HTTP_LOG_MODE: quiet / summary / detail
ORCA_HTTP_LOG_MODE=summary
# production-like 環境では false を維持する。true は localhost / RFC1918 向け HTTP 接続の限定例外。
OPENDOLPHIN_ORCA_ALLOW_INSECURE_HTTP=false
# facility-scoped transport cache TTL。0 は毎回再解決。
ORCA_TRANSPORT_CACHE_TTL_MS=30000
# ORCA proxy response header forwarding. 明示的に true の場合のみ X-Orca-* / Api-Result-Message を外へ出す。
ORCA_PROXY_FORWARD_X_ORCA_HEADERS=false
ORCA_PROXY_FORWARD_API_RESULT_MESSAGE_HEADER=false
# 一部 WebORCA 環境で acceptmodv2 の Acceptance_Push workaround が必要な場合だけ true。
# default は false とし、必要な環境でのみ明示投入する。
ORCA_ACCEPTMOD_SUPPRESS_ACCEPTANCE_PUSH=false
# ORCA push runtime control (phase 1-2)
ORCA_PUSH_ENABLED=false
ORCA_PUSH_SHADOW_MODE=false
ORCA_PUSH_RECEPTION_ENABLED=true
ORCA_PUSH_MEDICAL_ENABLED=false
ORCA_PUSH_CONNECT_TIMEOUT_MS=5000
ORCA_PUSH_PING_INTERVAL_SECONDS=20
ORCA_PUSH_IDLE_TIMEOUT_SECONDS=60
ORCA_PUSH_RECONNECT_INITIAL_DELAY_MS=1000
ORCA_PUSH_RECONNECT_MAX_DELAY_MS=30000
ORCA_PUSH_RECOVERY_ENABLED=false
ORCA_PUSH_RECOVERY_USE_PUSHEVENTGET=false
ORCA_PUSH_RECOVERY_INTERVAL_MINUTES=5
ORCA_PUSH_RECOVERY_INITIAL_LOOKBACK_MINUTES=30
ORCA_PUSH_RECOVERY_OVERLAP_MINUTES=5
ORCA_PUSH_DEDUP_RETENTION_DAYS=14

# ORCA 接続情報保護鍵 (必須)
# resolver key: orca.credentials.aes-key-b64
# ORCA password / client certificate / CA certificate の暗号化専用
ORCA_CREDENTIALS_AES_KEY_B64=

# 実行環境・安全側デフォルト
# OPENDOLPHIN_ENVIRONMENT は必須運用キー（例: dev / stg / prod）
OPENDOLPHIN_ENVIRONMENT=dev
# OPENDOLPHIN_TIMEZONE は必須。暗黙 JST fallback は使わない。
OPENDOLPHIN_TIMEZONE=Asia/Tokyo
OPENDOLPHIN_FACILITY_ID=your-facility-id
OPENDOLPHIN_CLOUD_ZERO=false
OPENDOLPHIN_PVT_LIST_CLEAR=false
OPENDOLPHIN_PVT_ENABLED=false
OPENDOLPHIN_PVT_BIND_IP=127.0.0.1
OPENDOLPHIN_PVT_PORT=5000
OPENDOLPHIN_PVT_ENCODING=UTF-8
OPENDOLPHIN_PVT_ACCEPT_TIMEOUT_MILLIS=30000
OPENDOLPHIN_PVT_READ_TIMEOUT_MILLIS=30000
OPENDOLPHIN_PVT_MAX_THREADS=10
OPENDOLPHIN_PVT_QUEUE_CAPACITY=100
OPENDOLPHIN_PVT_RETRY_MAX=3
OPENDOLPHIN_PVT_RETRY_BACKOFF_MILLIS=1000
OPENDOLPHIN_PVT_IDEMPOTENCY_WINDOW_MILLIS=600000
OPENDOLPHIN_PVT_POISON_QUEUE_CAPACITY=100
OPENDOLPHIN_PVT_WORKER_HEALTH_STALE_SUCCESS_SECONDS=180
OPENDOLPHIN_PVT_WORKER_HEALTH_MAX_PROCESSING_MILLIS=30000

# 定期処理（既定 OFF。必要時のみ明示的に true へ変更）
CHARTEVENT_HISTORY_REPLAYLIMIT=200
CHARTEVENT_HISTORY_RETENTIONCOUNT=10000
CHARTEVENT_HISTORY_RETENTIONHOURS=24
CHART_EVENT_HISTORY_PURGE_ENABLED=false
CHART_EVENT_HISTORY_PURGE_INTERVAL_MINUTES=5
ORCA_PATIENT_SYNC_ENABLED=false
ORCA_PATIENT_SYNC_INTERVAL_MINUTES=5
ORCA_PATIENT_SYNC_INITIAL_LOOKBACK_DAYS=7
ORCA_PATIENT_SYNC_INCLUDE_TEST_PATIENT=false
ORCA_PATIENT_SYNC_INCLUDE_INSURANCE=false
# 未設定時は jboss.server.data.dir 配下へ保存
ORCA_PATIENT_SYNC_STATE_PATH=
MASTER_UPDATE_SCHEDULER_ENABLED=false
METRICS_REGISTRY_JNDI=java:jboss/micrometer/registry

# 永続化パス（システムプロパティ必須）
# server-modernized は /tmp / user.home フォールバックを使用しない。
# 起動時に必ず -Djboss.server.data.dir=/var/lib/opendolphin/data を指定すること。
JBOSS_SERVER_DATA_DIR=/var/lib/opendolphin/data
JBOSS_BIND_ADDRESS=
# reverse proxy を信頼する IP/CIDR。comma-separated exact IP/CIDR。未設定時は loopback のみ。
# production-like 環境では 1 つ以上の許可 proxy rule が必須。
SECURITY_TRUSTED_PROXIES=
OPENDOLPHIN_TEMPLATES_DIR=
OPENDOLPHIN_LICENSE_DIR=

# 添付ストレージ
# ATTACHMENT_STORAGE_MODE: s3
# production-like / stopgap 契約では s3 のみ許可する。database と ATTACHMENT_STORAGE_DATABASE_LOB_TABLE は常時拒否される。
ATTACHMENT_STORAGE_MODE=s3
# 禁止設定を sample contract に明示する。production-like では空のまま維持すること。
ATTACHMENT_STORAGE_DATABASE_LOB_TABLE=
ATTACHMENT_STORAGE_S3_BUCKET=
ATTACHMENT_STORAGE_S3_REGION=
ATTACHMENT_STORAGE_S3_ENDPOINT=
ATTACHMENT_STORAGE_S3_BASE_PATH=attachments
ATTACHMENT_STORAGE_S3_FORCE_PATH_STYLE=true
ATTACHMENT_STORAGE_S3_SERVER_SIDE_ENCRYPTION=
ATTACHMENT_STORAGE_S3_KMS_KEY_ID=
ATTACHMENT_STORAGE_S3_MULTIPART_THRESHOLD_MB=64
ATTACHMENT_STORAGE_S3_ACCESS_KEY=
ATTACHMENT_STORAGE_S3_SECRET_KEY=

# 患者画像
# patient-images.enabled=true の場合、max-bytes / max-width / max-height は必須。
# upload は temp file へ streaming し、download URL は request base URI から構築する。
PATIENT_IMAGES_ENABLED=false
PATIENT_IMAGES_MAX_BYTES=5242880
PATIENT_IMAGES_MAX_WIDTH=4096
PATIENT_IMAGES_MAX_HEIGHT=4096

# 2FA AES 鍵 (必須)
FACTOR2_AES_KEY_B64=
# ↑ 32 バイト乱数を Base64 した値を設定。未設定で WildFly を起動すると `IllegalStateException` によりデプロイが中断される。

# SMTP 通知
SMTP_HOST=
SMTP_PORT=25
SMTP_AUTH=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_BCC=
SMTP_STARTTLS=false
SMTP_ACTIVITY_TO=

# Plivo SMS (利用時のみ設定)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SOURCE_NUMBER=
PLIVO_BASE_URL=https://api.plivo.com/v1/
PLIVO_ENVIRONMENT=production
PLIVO_DEFAULT_COUNTRY=+81
PLIVO_LOG_LEVEL=NONE
PLIVO_LOG_MESSAGE_CONTENT=false
PLIVO_HTTP_CONNECT_TIMEOUT=PT10S
PLIVO_HTTP_READ_TIMEOUT=PT30S
PLIVO_HTTP_WRITE_TIMEOUT=PT30S
PLIVO_HTTP_CALL_TIMEOUT=PT45S
PLIVO_HTTP_RETRY_ON_CONNECTION_FAILURE=true

# カルテ本文真正性シール(HMAC)
# `DOCUMENT_INTEGRITY_MODE` は `enforce` 固定。`DOCUMENT_INTEGRITY_KEYRING_PATH` は絶対パスの有効 JSON で必須。
# keyring JSON は algorithm=HMAC-SHA256、active ちょうど 1 件、verify-only 許容、各 hmacKeyB64 は Base64 デコード後 32 バイト以上。
DOCUMENT_INTEGRITY_MODE=enforce
DOCUMENT_INTEGRITY_KEYRING_PATH=

# Hibernate 実行時プロファイル
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
