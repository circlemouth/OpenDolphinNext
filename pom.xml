<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                        http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>opendolphin</groupId>
  <artifactId>opendolphin</artifactId>
  <version>2.7.1</version>
  <packaging>pom</packaging>
  <name>OpenDolphin</name>

  <modules>
    <module>persistence</module>
    <module>reporting</module>
    <module>server</module>
    <module>server-modernized</module>
    <module>client</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <surefire.failIfNoSpecifiedTests>true</surefire.failIfNoSpecifiedTests>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>opendolphin</groupId>
        <artifactId>opendolphin-api-contract</artifactId>
        <version>${project.version}</version>
        <type>jar</type>
      </dependency>
      <dependency>
        <groupId>opendolphin</groupId>
        <artifactId>opendolphin-persistence</artifactId>
        <version>${project.version}</version>
        <type>jar</type>
      </dependency>
      <dependency>
        <groupId>opendolphin</groupId>
        <artifactId>opendolphin-client</artifactId>
        <version>${project.version}</version>
        <type>jar</type>
      </dependency>
      <dependency>
        <groupId>opendolphin</groupId>
        <artifactId>opendolphin-server</artifactId>
        <version>${project.version}</version>
        <type>war</type>
      </dependency>
      <dependency>
        <groupId>opendolphin</groupId>
        <artifactId>opendolphin-server-modernized</artifactId>
        <version>${project.version}</version>
        <type>war</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <failIfNoSpecifiedTests>${surefire.failIfNoSpecifiedTests}</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <failIfNoSpecifiedTests>${surefire.failIfNoSpecifiedTests}</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.2</version>
          <configuration>
            <source>1.8</source>
            <target>1.8</target>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>bridge-fail-if-no-tests-cli</id>
      <activation>
        <property>
          <name>failIfNoTests</name>
        </property>
      </activation>
      <properties>
        <surefire.failIfNoSpecifiedTests>${failIfNoTests}</surefire.failIfNoSpecifiedTests>
      </properties>
    </profile>
  </profiles>

</project>
