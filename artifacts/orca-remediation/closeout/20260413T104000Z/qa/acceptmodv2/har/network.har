            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/features/patients/patients.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"/Users/Hayato/Documents/GitHub/OpenDolphin_WebClient/web-client/src/features/patients/patients.css\"\nconst __vite__css = \".patients-page {\\n  background: rgba(255, 255, 255, 0.92);\\n  border: 1px solid var(--ui-border-subtle);\\n  border-radius: var(--ui-radius-lg);\\n  padding: 1.5rem;\\n  box-shadow: var(--ui-shadow-soft);\\n  display: flex;\\n  flex-direction: column;\\n  gap: 1.15rem;\\n}\\n\\n.patients-page__header {\\n  display: flex;\\n  align-items: flex-start;\\n  justify-content: space-between;\\n  gap: 1rem;\\n  flex-wrap: wrap;\\n}\\n\\n.patients-page__kicker {\\n  margin: 0;\\n  text-transform: uppercase;\\n  letter-spacing: 0.08em;\\n  font-size: 0.8rem;\\n  color: #64748b;\\n}\\n\\n.patients-page__hint {\\n  margin: 0.35rem 0 0;\\n  color: #475569;\\n  line-height: 1.6;\\n}\\n\\n.patients-page__badges {\\n  display: flex;\\n  gap: 0.5rem;\\n  flex-wrap: wrap;\\n  justify-content: flex-end;\\n  align-items: center;\\n}\\n\\n.patients-page__return {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.75rem;\\n  align-items: center;\\n  justify-content: space-between;\\n  padding: 0.75rem 1rem;\\n  border-radius: var(--ui-radius-lg);\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface-muted);\\n}\\n\\n.patients-page__return-main {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.75rem;\\n  align-items: center;\\n}\\n\\n.patients-page__return-label {\\n  font-weight: 700;\\n  color: #0f172a;\\n}\\n\\n.patients-page__return-actions {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n}\\n\\n.patients-page__return-meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n  align-items: center;\\n  font-size: 0.85rem;\\n  color: #475569;\\n}\\n\\n.patients-page__return-detail {\\n  color: #475569;\\n}\\n\\n.patients-search {\\n  background: var(--ui-surface-elevated);\\n  border-radius: var(--ui-radius-lg);\\n  padding: 1.25rem;\\n  border: 1px solid var(--ui-border-subtle);\\n  box-shadow: none;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.75rem;\\n}\\n\\n.patients-search__form {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.85rem;\\n}\\n\\n.patients-search__row {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\\n  gap: 0.75rem;\\n}\\n\\n.patients-search__field {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.35rem;\\n  font-weight: 600;\\n  color: #0f172a;\\n  font-size: 0.92rem;\\n}\\n\\n.patients-search__field input,\\n.patients-search__field select {\\n  width: 100%;\\n  border-radius: 12px;\\n  border: 1px solid #cbd5e1;\\n  padding: 0.55rem 0.75rem;\\n  background: #ffffff;\\n  font-size: 0.95rem;\\n}\\n\\n.patients-search__actions {\\n  display: flex;\\n  gap: 0.6rem;\\n  flex-wrap: wrap;\\n}\\n\\n.patients-search__saved {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.6rem;\\n  padding: 0.75rem;\\n  background: var(--ui-surface-muted);\\n  border-radius: 16px;\\n  border: 1px solid var(--ui-border);\\n}\\n\\n.patients-search__saved-meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n  font-size: 0.85rem;\\n  color: #475569;\\n}\\n\\n.patients-search__saved-share {\\n  font-weight: 700;\\n  color: #1d4ed8;\\n}\\n\\n.patients-search__saved-updated {\\n  color: #475569;\\n}\\n\\n.patients-search__saved-row {\\n  display: flex;\\n  gap: 0.6rem;\\n  flex-wrap: wrap;\\n  align-items: flex-end;\\n}\\n\\n.patients-search__button {\\n  padding: 0.65rem 1rem;\\n  border-radius: var(--ui-radius-md);\\n  border: 1px solid #1d4ed8;\\n  background: #ffffff;\\n  color: #1d4ed8;\\n  font-weight: 700;\\n  cursor: pointer;\\n  transition: transform 0.08s ease, background 0.2s ease, colo