ght: 700;\\n}\\n\\n.patients-page__insurance-summary-meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n  font-size: 0.8rem;\\n  color: #475569;\\n}\\n\\n.patients-page__insurance-group {\\n  background: #ffffff;\\n  border: 1px solid rgba(148, 163, 184, 0.3);\\n  border-radius: 12px;\\n  padding: 0.75rem;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.5rem;\\n}\\n\\n.patients-page__insurance-group-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: baseline;\\n  color: #0f172a;\\n}\\n\\n.patients-page__insurance-group ul {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.5rem;\\n}\\n\\n.patients-page__insurance-group li {\\n  display: flex;\\n  justify-content: space-between;\\n  gap: 0.6rem;\\n  align-items: flex-start;\\n  border: 1px solid rgba(148, 163, 184, 0.2);\\n  border-radius: 10px;\\n  padding: 0.5rem 0.6rem;\\n  background: #f8fafc;\\n}\\n\\n.patients-page__insurance-item-main {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.2rem;\\n}\\n\\n.patients-page__insurance-item-actions {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: flex-end;\\n  gap: 0.35rem;\\n}\\n\\n\\n.patients-page__insurance-group li span {\\n  display: block;\\n  color: #0f172a;\\n  font-weight: 600;\\n}\\n\\n.patients-page__insurance-group li small {\\n  display: block;\\n  color: #64748b;\\n}\\n\\n.patients-page__insurance-group button {\\n  border: none;\\n  border-radius: 10px;\\n  padding: 0.4rem 0.7rem;\\n  font-weight: 700;\\n  cursor: pointer;\\n  background: #0f172a;\\n  color: #ffffff;\\n}\\n\\n.patients-page__insurance-group button:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n@media (max-width: 960px) {\\n  .patients-page__content {\\n    grid-template-columns: 1fr;\\n  }\\n\\n  .patients-page__list {\\n    max-height: none;\\n  }\\n}\\n\\n.patients-page__orca-memo {\\n  border-radius: 14px;\\n  border: 1px solid rgba(148, 163, 184, 0.25);\\n  background: #f8fafc;\\n  padding: 1rem;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.75rem;\\n}\\n\\n.patients-page__orca-memo-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: flex-start;\\n  gap: 0.75rem;\\n  flex-wrap: wrap;\\n}\\n\\n.patients-page__orca-memo-kicker {\\n  margin: 0;\\n  font-size: 0.75rem;\\n  text-transform: uppercase;\\n  letter-spacing: 0.08em;\\n  color: #64748b;\\n}\\n\\n.patients-page__orca-memo-sub {\\n  margin: 0.35rem 0 0;\\n  color: #475569;\\n  font-size: 0.85rem;\\n}\\n\\n.patients-page__orca-memo-actions {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.5rem;\\n}\\n\\n.patients-page__orca-memo-actions button {\\n  border: none;\\n  border-radius: 10px;\\n  padding: 0.6rem 0.9rem;\\n  font-weight: 700;\\n  cursor: pointer;\\n  background: #0f172a;\\n  color: #ffffff;\\n}\\n\\n.patients-page__orca-memo-actions button.ghost {\\n  background: #e2e8f0;\\n  color: #0f172a;\\n}\\n\\n.patients-page__orca-memo-meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.75rem;\\n  font-size: 0.85rem;\\n  color: #475569;\\n}\\n\\n.patients-page__orca-memo-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\\n  gap: 0.6rem;\\n}\\n\\n.patients-page__orca-memo-grid label {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.25rem;\\n  color: #475569;\\n  font-size: 0.85rem;\\n}\\n\\n.patients-page__orca-memo-grid input {\\n  border: 1px solid #cbd5e1;\\n  border-radius: 10px;\\n  padding: 0.5rem 0.6rem;\\n  font-size: 0.9rem;\\n  font-family: inherit;\\n}\\n\\n.patients-page__orca-memo-textarea {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.35rem;\\n  color: #475569;\\n}\\n\\n.patients-page__orca-memo-textarea textarea {\\n  border: 1px solid #cbd5e1;\\n  border-radius: 10px;\\n  padding: 0.6rem 0.75rem;\\n  font-size: 0.95rem;\\n  font-family: inherit;\\n  resize: vertical;\\n}\\n\\n.patients-page__orca-memo-empty {\\n  margin: 0;\\n  color: #64748b;\\n}\\n\\n.patients-page__orca-memo-list summary {\\n  cursor: pointer;\\n  font-weight: 700;\\n}\\n\\n.patients-page__orca-memo-list ul {\\n  margin: 0.5rem 0 0;\\n  padding-left: 1.1rem;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.4rem;\\n  color: #475569;\\n}\\n\\n.patients-page__orca-memo-list li strong {\\n  display: block;\\n  color: #0f172a;\\n}\\n\\n.patients-page__orca-memo-list li span {\\n  display: block;\\n  margin-top: 0.2rem;\\n}\\n\\n.patients-page__orca-memo-list li small {\\n  display: block;\\n  margin-top: 0.2rem;\\n  color: #64748b;\\n}\\n\\n.patients-page__orca-memo-warning {\\n  color: #b45309;\\n  font-weight: 600;\\n}\\n\\n.patients-page__orca-status-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\\n  gap: 0.75rem;\\n}\\n\\n.patients-page__orca-status-card {\\n  border-radius: 12px;\\n  border: 1px solid rgba(148, 163, 184, 0.25);\\n  background: #ffffff;\\n  padding: 0.7rem 0.8rem;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.6rem;\\n}\\n\\n.patients-page__orca-status-head {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: baseline;\\n  color: #0f172a;\\n  font-size: 0.85rem;\\n}\\n\\n.patients-page__orca-status-head span {\\n  color: #64748b;\\n  font-size: 0.75rem;\\n}\\n\\n.patients-page__orca-status-note {\\n  margin: 0;\\n  font-size: 0.75rem;\\n  color: #475569;\\n}\\n\\n.patients-page__orca-status-note a {\\n  color: #1d4ed8;\\n  font-weight: 700;\\n  margin-left: 0.3rem;\\n  text-decoration: none;\\n}\\n\\n.patients-page__orca-status-note a:hover {\\n  text-decoration: underline;\\n}\\n\\n/* Patients page brush-up overrides */\\n.patients-page {\\n  --patients-text-strong: #0f172a;\\n  --patients-text-muted: #475569;\\n  --patients-text-soft: #64748b;\\n  --patients-accent-strong: var(--ui-info-text);\\n  --patients-accent-bg: var(--ui-info-bg);\\n  --patients-accent-border: var(--ui-info-border);\\n  --patients-surface: var(--ui-surface);\\n  --patients-surface-muted: var(--ui-surface-muted);\\n  --patients-input-border: var(--ui-border-strong);\\n  height: 100%;\\n  min-height: 0;\\n}\\n\\n.patients-page__header {\\n  border: 1px solid var(--ui-border);\\n  border-radius: 14px;\\n  background: var(--patients-surface-muted);\\n  padding: 0.85rem 1rem;\\n}\\n\\n.patients-page__kicker {\\n  color: var(--patients-text-soft);\\n}\\n\\n.patients-page__hint {\\n  color: var(--patients-text-muted);\\n}\\n\\n.patients-page__ops-metrics {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.45rem;\\n  align-items: center;\\n}\\n\\n.patients-page__ops-metrics span {\\n  border-radius: 999px;\\n  padding: 0.25rem 0.7rem;\\n  border: 1px solid var(--ui-border);\\n  background: var(--patients-surface);\\n  color: var(--patients-text-muted);\\n  font-size: 0.8rem;\\n  font-weight: 700;\\n}\\n\\n.patients-page__ops-status.is-ok {\\n  border-color: var(--ui-success-border);\\n  background: var(--ui-success-bg);\\n  color: var(--ui-success-text);\\n}\\n\\n.patients-page__ops-status.is-alert {\\n  border-color: var(--ui-warning-border);\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n}\\n\\n.patients-page__network-details {\\n  border: 1px dashed var(--ui-border-strong);\\n  border-radius: 12px;\\n  padding: 0.55rem 0.75rem;\\n  background: var(--patients-surface);\\n}\\n\\n.patients-page__network-details > summary {\\n  cursor: pointer;\\n  font-weight: 700;\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-page__network-meta {\\n  margin-top: 0.55rem;\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n  color: var(--patients-text-muted);\\n  font-size: 0.83rem;\\n}\\n\\n.patients-search__field {\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-search__field input,\\n.patients-search__field select {\\n  border-color: var(--patients-input-border);\\n  background: var(--patients-surface);\\n}\\n\\n.patients-search__button {\\n  border-color: var(--patients-accent-border);\\n  background: var(--patients-surface);\\n  color: var(--patients-accent-strong);\\n}\\n\\n.patients-search__button.primary {\\n  border-color: var(--patients-accent-strong);\\n  background: var(--patients-accent-strong);\\n  color: #fff;\\n}\\n\\n.patients-search__button.ghost:hover {\\n  background: var(--patients-accent-bg);\\n}\\n\\n.patients-search__pending {\\n  border: 1px solid var(--ui-warning-border);\\n  border-radius: 12px;\\n  padding: 0.55rem 0.7rem;\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  font-size: 0.84rem;\\n  font-weight: 700;\\n}\\n\\n.patients-search__import {\\n  display: flex;\\n  gap: 0.65rem;\\n  align-items: flex-end;\\n  flex-wrap: wrap;\\n  border: 1px solid var(--patients-accent-border);\\n  border-radius: 14px;\\n  padding: 0.7rem;\\n  background: var(--patients-accent-bg);\\n}\\n\\n.patients-search__summary-main {\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-search__summary-state {\\n  color: var(--patients-accent-strong);\\n}\\n\\n.patients-search__summary-meta,\\n.patients-search__saved-meta,\\n.patients-page__return-meta,\\n.patients-page__return-detail {\\n  color: var(--patients-text-muted);\\n}\\n\\n.patients-search__saved-share {\\n  color: var(--patients-accent-strong);\\n}\\n\\n.patients-page__content {\\n  flex: 1;\\n  min-height: 0;\\n  grid-template-columns: minmax(290px, 34%) 1fr;\\n}\\n\\n.patients-page__list {\\n  max-height: none;\\n  min-height: 0;\\n  overflow: auto;\\n}\\n\\n.patients-page__row {\\n  border-left: 4px solid transparent;\\n}\\n\\n.patients-page__row.is-selected {\\n  border-left-color: var(--patients-accent-strong);\\n  border-color: var(--ui-selection-border);\\n  background: var(--ui-selection-bg);\\n  box-shadow: none;\\n}\\n\\n.patients-page__row-id {\\n  color: var(--patients-accent-strong);\\n  background: var(--patients-accent-bg);\\n  border-color: var(--patients-accent-border);\\n}\\n\\n.patients-page__row-kana,\\n.patients-page__field-help {\\n  color: var(--patients-text-soft);\\n}\\n\\n.patients-page__row-meta {\\n  color: var(--patients-text-muted);\\n}\\n\\n.patients-page__row-insurance {\\n  max-width: 100%;\\n}\\n\\n.patients-page__form {\\n  display: flex;\\n  flex-direction: column;\\n  min-height: 0;\\n  overflow: hidden;\\n}\\n\\n.patients-page__selection-placeholder {\\n  border: 1px dashed var(--patients-accent-border);\\n  background: var(--patients-accent-bg);\\n  color: var(--patients-accent-strong);\\n  border-radius: var(--ui-radius-md);\\n  padding: 0.6rem 0.85rem;\\n  font-weight: 700;\\n}\\n\\n.patients-page__detail-tabs {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.5rem;\\n  border-bottom: 0;\\n  padding-bottom: 0;\\n}\\n\\n.patients-page__detail-tab {\\n  border: 1px solid transparent;\\n  background: transparent;\\n  color: var(--patients-text-muted);\\n  border-radius: var(--ui-radius-sm);\\n  padding: 0.45rem 0.8rem;\\n  cursor: pointer;\\n  font-weight: 700;\\n}\\n\\n.patients-page__detail-tab:focus-visible {\\n  outline: 2px solid var(--patients-accent-strong);\\n  outline-offset: 2px;\\n}\\n\\n.patients-page__detail-tab.is-active {\\n  border-color: var(--ui-selected-border);\\n  background: var(--ui-selected-bg);\\n  color: var(--ui-text);\\n  box-shadow: inset 3px 0 0 var(--ui-selected-rail);\\n}\\n\\n.patients-page__detail-panel {\\n  flex: 1;\\n  min-height: 0;\\n  overflow: auto;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.75rem;\\n}\\n\\n.patients-page__detail-panel[hidden] {\\n  display: none;\\n}\\n\\n.patients-page__basic-form {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 1rem;\\n}\\n\\n.patients-page__form-actions button {\\n  background: var(--patients-accent-strong);\\n  color: #fff;\\n}\\n\\n.patients-page__form-actions button.ghost {\\n  border: 1px solid var(--patients-accent-border);\\n  background: var(--patients-accent-bg);\\n  color: var(--patients-accent-strong);\\n}\\n\\n.patients-page__sticky-bar {\\n  position: sticky;\\n  top: 0;\\n  z-index: 4;\\n  background: var(--patients-surface);\\n  padding-top: 0.15rem;\\n}\\n\\n.patients-page__change-summary {\\n  border: 1px solid var(--ui-border);\\n  border-radius: 12px;\\n  background: var(--patients-surface-muted);\\n  padding: 0.6rem 0.75rem;\\n  display: grid;\\n  gap: 0.45rem;\\n}\\n\\n.patients-page__change-summary-label {\\n  font-weight: 800;\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-page__change-empty {\\n  color: var(--patients-text-soft);\\n  font-size: 0.85rem;\\n}\\n\\n.patients-page__change-chips {\\n  display: flex;\\n  gap: 0.45rem;\\n  flex-wrap: wrap;\\n}\\n\\n.patients-page__change-chip {\\n  border-radius: 999px;\\n  border: 1px solid var(--patients-accent-border);\\n  background: var(--patients-accent-bg);\\n  color: var(--patients-accent-strong);\\n  font-size: 0.76rem;\\n  font-weight: 700;\\n  padding: 0.2rem 0.55rem;\\n}\\n\\n.patients-page__change-details summary {\\n  cursor: pointer;\\n  color: var(--patients-text-muted);\\n  font-weight: 700;\\n}\\n\\n.patients-page__change-details ul {\\n  margin: 0.45rem 0 0;\\n  padding-left: 1.1rem;\\n  color: var(--patients-text-muted);\\n  font-size: 0.84rem;\\n  display: grid;\\n  gap: 0.2rem;\\n}\\n\\n.patients-page__switch-dialog {\\n  display: grid;\\n  gap: 0.55rem;\\n}\\n\\n.patients-page__switch-dialog p {\\n  margin: 0;\\n  color: var(--patients-text-muted);\\n}\\n\\n.patients-page__switch-dialog-note {\\n  font-weight: 700;\\n}\\n\\n.patients-page__switch-dialog-actions {\\n  margin-top: 0.35rem;\\n  display: flex;\\n  justify-content: flex-end;\\n  gap: 0.45rem;\\n  flex-wrap: wrap;\\n}\\n\\n@media (max-width: 960px) {\\n  .patients-page {\\n    min-height: auto;\\n  }\\n\\n  .patients-page__content {\\n    grid-template-columns: 1fr;\\n    min-height: auto;\\n  }\\n\\n  .patients-page__form {\\n    min-height: 480px;\\n  }\\n}\\n\\n/* Patients UI guideline normalization */\\n.patients-page {\\n  --patients-radius-tab: 8px;\\n  --patients-radius-input: 8px;\\n  --patients-radius-card: 12px;\\n  --patients-radius-modal: 16px;\\n}\\n\\n.patients-page,\\n.patients-page__header,\\n.patients-page__return,\\n.patients-search,\\n.patients-search__saved,\\n.patients-search__summary,\\n.patients-page__list,\\n.patients-page__form,\\n.patients-page__change-summary,\\n.patients-page__orca-memo,\\n.patients-page__insurance-summary,\\n.patients-page__insurance-group,\\n.patients-page__orca-status-card,\\n.patients-page__orca-original-response {\\n  border-radius: var(--patients-radius-card);\\n}\\n\\n.patients-page__switch-dialog {\\n  border-radius: var(--patients-radius-modal);\\n}\\n\\n.patients-page__detail-tabs {\\n  border-bottom-color: transparent;\\n}\\n\\n.patients-page__detail-tab {\\n  border-radius: var(--ui-radius-sm);\\n  border-color: transparent;\\n  border-bottom: 0;\\n  background: transparent;\\n}\\n\\n.patients-page__detail-tab.is-active {\\n  border-color: var(--ui-selected-border);\\n  font-weight: 800;\\n}\\n\\n.patients-search__button,\\n.patients-page__form-actions button,\\n.patients-page__empty-actions button,\\n.patients-page__retry-save-actions button,\\n.patients-page__orca-original-actions button,\\n.patients-page__insurance-actions button,\\n.patients-page__insurance-group button,\\n.patients-page__orca-memo-actions button {\\n  border: 1px solid var(--ui-border-strong);\\n  border-radius: var(--patients-radius-input);\\n  background: var(--patients-surface);\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-search__button.primary,\\n.patients-page__form-actions button:not(.ghost) {\\n  border-color: var(--patients-accent-strong);\\n  background: var(--patients-accent-strong);\\n  color: #ffffff;\\n}\\n\\n.patients-search__button.ghost,\\n.patients-page__form-actions button.ghost,\\n.patients-page__orca-original-actions button.ghost,\\n.patients-page__insurance-actions button.ghost,\\n.patients-page__orca-memo-actions button.ghost {\\n  border-color: var(--patients-accent-border);\\n  background: var(--patients-accent-bg);\\n  color: var(--patients-accent-strong);\\n}\\n\\n.patients-page__form-actions button.ghost.danger {\\n  border-color: var(--ui-error-border);\\n  background: var(--ui-error-bg);\\n  color: var(--ui-error-text);\\n}\\n\\n.patients-search__field input,\\n.patients-search__field select,\\n.patients-page__grid input,\\n.patients-page__grid select,\\n.patients-page__grid textarea,\\n.patients-page__audit-filters input,\\n.patients-page__audit-filters select,\\n.patients-page__orca-original-grid input,\\n.patients-page__insurance-grid input,\\n.patients-page__orca-memo-grid input,\\n.patients-page__orca-memo-textarea textarea {\\n  border: 1px solid var(--ui-border-strong);\\n  border-radius: var(--patients-radius-input);\\n}\\n\\n.patients-page__orca-original-response,\\n.patients-page__insurance-summary,\\n.patients-page__insurance-group,\\n.patients-page__orca-memo,\\n.patients-page__orca-status-card {\\n  border-color: var(--ui-border);\\n}\\n/* === Patients UX Split Layout (Final Override) === */\\n\\n.patients-page {\\n  /* 画面全体スクロールを極力発生させず、左/右ペイン内で完結させる */\\n  height: 100%;\\n  min-height: 0;\\n  overflow: hidden;\\n}\\n\\n/* 2ペイン幅（左：検索＋一覧 / 右：詳細） */\\n.patients-page__content.patients-page__split {\\n  grid-template-columns: var(--patients-sidebar-width, 380px) 10px 1fr;\\n}\\n\\n.patients-page__splitter {\\n  position: relative;\\n  width: 10px;\\n  cursor: col-resize;\\n  border: none;\\n  border-radius: 999px;\\n  background: transparent;\\n}\\n\\n.patients-page__splitter::before {\\n  content: '';\\n  position: absolute;\\n  left: 50%;\\n  top: 0.3rem;\\n  bottom: 0.3rem;\\n  width: 2px;\\n  border-radius: 999px;\\n  transform: translateX(-50%);\\n  background: var(--ui-border);\\n  transition: background-color 0.15s ease, box-shadow 0.15s ease;\\n}\\n\\n.patients-page__splitter:hover::before,\\n.patients-page__splitter:focus-visible::before,\\n.patients-page__splitter.is-dragging::before {\\n  background: var(--ui-primary);\\n  box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);\\n}\\n\\n.patients-page__splitter:focus-visible {\\n  outline: 2px solid var(--ui-focus-ring);\\n  outline-offset: 1px;\\n}\\n\\n.patients-page__splitter.is-dragging {\\n  background: rgba(29, 78, 216, 0.08);\\n}\\n\\n/* 左カラム：検索＋status＋一覧 */\\n.patients-page__sidebar {\\n  min-height: 0;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.75rem;\\n}\\n\\n/* 検索カードをコンパクト化 */\\n.patients-search {\\n  padding: 0.85rem;\\n  gap: 0.65rem;\\n}\\n\\n/* 新：検索 primary 行 */\\n.patients-search__primary {\\n  display: flex;\\n  gap: 0.6rem;\\n  align-items: flex-end;\\n  flex-wrap: wrap;\\n}\\n\\n.patients-search__field--keyword {\\n  flex: 1;\\n  min-width: 220px;\\n}\\n\\n.patients-search__primary-actions {\\n  display: flex;\\n  gap: 0.45rem;\\n  align-items: center;\\n  flex-wrap: wrap;\\n}\\n\\n.patients-search__pending-pill {\\n  border-radius: 999px;\\n  padding: 0.25rem 0.6rem;\\n  font-size: 0.78rem;\\n  font-weight: 900;\\n  border: 1px solid var(--ui-warning-border);\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n}\\n\\n/* details を “見た目の段落” にする */\\n.patients-search__advanced {\\n  border: 1px solid var(--ui-border);\\n  border-radius: var(--patients-radius-card);\\n  background: var(--patients-surface-muted);\\n  padding: 0.55rem 0.65rem;\\n}\\n\\n.patients-search__advanced > summary {\\n  cursor: pointer;\\n  font-weight: 800;\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-search__advanced[open] {\\n  background: var(--patients-surface);\\n}\\n\\n/* 左：ステータスバー */\\n.patients-sidebar__statusbar {\\n  border: 1px solid var(--ui-border-subtle);\\n  background: rgba(248, 250, 252, 0.96);\\n  border-radius: var(--ui-radius-lg);\\n  padding: 0.65rem 0.75rem;\\n  display: grid;\\n  gap: 0.35rem;\\n}\\n\\n.patients-sidebar__statusbar-main {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: baseline;\\n  gap: 0.5rem;\\n}\\n\\n.patients-sidebar__statusbar-label {\\n  font-weight: 900;\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-sidebar__statusbar-count {\\n  font-weight: 900;\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-sidebar__statusbar-fetching {\\n  font-weight: 900;\\n  color: var(--patients-accent-strong);\\n}\\n\\n.patients-sidebar__statusbar-meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n  font-size: 0.82rem;\\n  color: var(--patients-text-muted);\\n}\\n\\n.patients-sidebar__statusbar-note {\\n  padding: 0.35rem 0.55rem;\\n  border-radius: var(--ui-radius-sm);\\n  font-weight: 900;\\n  font-size: 0.84rem;\\n  border: 1px solid transparent;\\n}\\n\\n.patients-sidebar__statusbar-note--info {\\n  background: var(--ui-info-bg);\\n  color: var(--ui-info-text);\\n  border-color: var(--ui-info-border);\\n}\\n\\n.patients-sidebar__statusbar-note--warning {\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  border-color: var(--ui-warning-border);\\n}\\n\\n/* 左：一覧だけスクロール */\\n.patients-page__list {\\n  flex: 1;\\n  min-height: 0;\\n  overflow: auto;\\n  padding: 0.6rem;\\n}\\n\\n/* 一覧行：列揃えGrid */\\n.patients-page__row {\\n  display: grid;\\n  grid-template-columns: 88px 1fr auto;\\n  grid-template-rows: auto auto;\\n  grid-template-areas:\\n    \\\"id name flags\\\"\\n    \\\"id meta flags\\\";\\n  gap: 0.25rem 0.6rem;\\n  align-items: center;\\n\\n  padding: 0.7rem 0.78rem;\\n  border: 1px solid transparent;\\n  border-radius: var(--ui-radius-md);\\n  background: transparent;\\n}\\n\\n.patients-page__row-id {\\n  grid-area: id;\\n  justify-self: start;\\n  align-self: start;\\n  margin-top: 0.1rem;\\n}\\n\\n.patients-page__row-name {\\n  grid-area: name;\\n  min-width: 0;\\n  display: grid;\\n  gap: 0.1rem;\\n}\\n\\n.patients-page__row-name-main {\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.patients-page__row-name-kana {\\n  font-size: 0.82rem;\\n  color: var(--patients-text-soft);\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.patients-page__row-flags {\\n  grid-area: flags;\\n  display: flex;\\n  flex-direction: column;\\n  align-items: flex-end;\\n  gap: 0.25rem;\\n}\\n\\n.patients-page__row-flag {\\n  border-radius: var(--ui-radius-sm);\\n  padding: 0.18rem 0.5rem;\\n  font-size: 0.74rem;\\n  font-weight: 900;\\n  border: 1px solid transparent;\\n}\\n\\n.patients-page__row-flag--unlinked {\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  border-color: var(--ui-warning-border);\\n}\\n\\n.patients-page__row-flag--detail {\\n  background: rgba(15, 23, 42, 0.04);\\n  color: var(--patients-text-muted);\\n  border-color: var(--ui-border);\\n}\\n\\n.patients-page__row-flag.is-blocked {\\n  background: var(--ui-error-bg);\\n  color: var(--ui-error-text);\\n  border-color: var(--ui-error-border);\\n}\\n\\n.patients-page__row-meta {\\n  grid-area: meta;\\n  min-width: 0;\\n\\n  display: grid;\\n  grid-template-columns: 92px 1fr auto;\\n  gap: 0.5rem;\\n  align-items: baseline;\\n\\n  font-size: 0.86rem;\\n  color: var(--patients-text-muted);\\n}\\n\\n.patients-page__row-meta-insurance {\\n  min-width: 0;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.patients-page__row-meta-last {\\n  justify-self: end;\\n  white-space: nowrap;\\n}\\n\\n/* 右：患者コンテキストヘッダ */\\n.patients-detail__context {\\n  border: 0;\\n  border-radius: 0;\\n  background: transparent;\\n  padding: 0;\\n  display: block;\\n}\\n\\n.patients-detail__identity-bar .patient-identity-bar__surface {\\n  box-shadow: var(--ui-shadow-soft);\\n  border-color: var(--ui-border-subtle);\\n}\\n\\n.patients-detail__context-kicker {\\n  margin: 0;\\n  font-size: 0.75rem;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: var(--patients-text-soft);\\n}\\n\\n.patients-detail__context-title {\\n  margin: 0.15rem 0 0;\\n  font-size: 1.05rem;\\n  color: var(--patients-text-strong);\\n}\\n\\n.patients-detail__context-meta {\\n  display: grid;\\n  gap: 0.45rem;\\n}\\n\\n.patients-detail__context-name {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n  align-items: baseline;\\n}\\n\\n.patients-detail__context-name-kana {\\n  color: var(--patients-text-soft);\\n  font-size: 0.9rem;\\n}\\n\\n.patients-detail__context-facts {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n  color: var(--patients-text-muted);\\n  font-size: 0.86rem;\\n}\\n\\n.patients-detail__context-badges {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.4rem;\\n}\\n\\n.patients-detail__badge {\\n  border-radius: var(--ui-radius-md);\\n  padding: 0.2rem 0.55rem;\\n  font-weight: 900;\\n  font-size: 0.78rem;\\n  border: 1px solid transparent;\\n}\\n\\n.patients-detail__badge.is-unlinked {\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  border-color: var(--ui-warning-border);\\n}\\n\\n.patients-detail__badge.is-blocked {\\n  background: var(--ui-error-bg);\\n  color: var(--ui-error-text);\\n  border-color: var(--ui-error-border);\\n}\\n\\n/* タブ：折返し禁止＋横スクロール */\\n.patients-page__detail-tabs {\\n  flex-wrap: nowrap;\\n  overflow-x: auto;\\n  overflow-y: hidden;\\n  white-space: nowrap;\\n  scrollbar-width: thin;\\n  gap: 0.35rem;\\n  padding: 0.28rem;\\n  border: 1px solid var(--ui-border-subtle);\\n  border-radius: var(--ui-radius-md);\\n  background: rgba(248, 250, 252, 0.96);\\n}\\n\\n.patients-page__detail-tab {\\n  white-space: nowrap;\\n  border-radius: var(--ui-radius-sm);\\n  border: 1px solid transparent;\\n  background: transparent;\\n  font-weight: 700;\\n}\\n\\n.patients-page__detail-tab.is-active {\\n  border-color: var(--ui-selected-border);\\n  background: var(--ui-selected-bg);\\n  color: var(--ui-text);\\n  box-shadow: inset 3px 0 0 var(--ui-selected-rail);\\n}\\n\\n/* basic内の小見出し */\\n.patients-page__section-title {\\n  margin: 0;\\n  font-size: 0.98rem;\\n  color: var(--patients-text-strong);\\n}\\n\