var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  border-color: var(--ui-warning-border);\\n}\\n\\n.admin-status--error {\\n  background: var(--ui-error-bg);\\n  color: var(--ui-error-text);\\n  border-color: var(--ui-error-border);\\n}\\n\\n.admin-status--warn {\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  border-color: var(--ui-warning-border);\\n}\\n\\n.admin-status--idle {\\n  background: var(--ui-surface-muted);\\n  color: #475569;\\n  border-color: var(--ui-border);\\n}\\n\\n.admin-divider {\\n  height: 1px;\\n  background: rgba(148, 163, 184, 0.35);\\n  margin: 0.75rem 0;\\n}\\n\\n.admin-result {\\n  display: grid;\\n  gap: 0.25rem;\\n  background: #ffffff;\\n  border: 1px solid rgba(148, 163, 184, 0.3);\\n  border-radius: 12px;\\n  padding: 0.6rem 0.75rem;\\n  font-size: 0.9rem;\\n  color: #0f172a;\\n}\\n\\n.admin-result--stack {\\n  margin-top: 0.5rem;\\n}\\n\\n.admin-callout {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: 0.75rem;\\n  border-radius: 12px;\\n  border: 1px solid rgba(148, 163, 184, 0.35);\\n  background: #ffffff;\\n  padding: 0.75rem 0.9rem;\\n  margin-bottom: 0.75rem;\\n}\\n\\n.admin-callout__body {\\n  flex: 1 1 220px;\\n  display: grid;\\n  gap: 0.35rem;\\n}\\n\\n.admin-callout__title {\\n  margin: 0;\\n  font-weight: 800;\\n  color: #0f172a;\\n}\\n\\n.admin-callout__actions {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n}\\n\\n.admin-step-list {\\n  margin: 0;\\n  padding-left: 1.1rem;\\n  color: #475569;\\n  font-size: 0.9rem;\\n  display: grid;\\n  gap: 0.2rem;\\n}\\n\\n.admin-summary {\\n  display: grid;\\n  gap: 0.35rem;\\n  font-size: 0.9rem;\\n  color: #0f172a;\\n}\\n\\n.admin-summary__row {\\n  display: grid;\\n  grid-template-columns: minmax(160px, 200px) 1fr;\\n  gap: 0.5rem;\\n}\\n\\n.admin-summary__label {\\n  font-weight: 700;\\n  color: #1f2937;\\n}\\n\\n.admin-error {\\n  color: #b91c1c;\\n  font-weight: 700;\\n}\\n\\n.admin-orca-link-status {\\n  display: grid;\\n  gap: 0.25rem;\\n}\\n\\n.admin-warning-box {\\n  border-radius: 12px;\\n  border: 1px solid rgba(245, 158, 11, 0.45);\\n  background: #fffbeb;\\n  color: #92400e;\\n  padding: 0.6rem 0.8rem;\\n  font-weight: 700;\\n}\\n\\n.admin-link {\\n  margin-left: 0.5rem;\\n  font-weight: 700;\\n  color: #1d4ed8;\\n}\\n\\n.admin-link--button {\\n  margin-left: 0;\\n  padding: 0.4rem 0.8rem;\\n  border-radius: 999px;\\n  border: 1px solid rgba(37, 99, 235, 0.35);\\n  background: #eef2ff;\\n  color: #1d4ed8;\\n  text-decoration: none;\\n}\\n\\n.admin-link:hover {\\n  text-decoration: underline;\\n}\\n\\n.admin-scroll {\\n  margin-top: 0.75rem;\\n  max-height: 260px;\\n  overflow: auto;\\n  border: 1px solid rgba(148, 163, 184, 0.3);\\n  border-radius: 12px;\\n  background: #ffffff;\\n}\\n\\n.admin-table {\\n  width: 100%;\\n  border-collapse: collapse;\\n}\\n\\n.admin-table th,\\n.admin-table td {\\n  border-bottom: 1px solid rgba(148, 163, 184, 0.2);\\n  padding: 0.4rem 0.5rem;\\n  text-align: left;\\n  font-size: 0.85rem;\\n}\\n\\n.admin-table th {\\n  font-weight: 800;\\n  background: #f1f5f9;\\n}\\n\\n.admin-version--diff {\\n  background: #fef3c7;\\n}\\n\\n.admin-button {\\n  border: 1px solid var(--ui-border-strong);\\n  border-radius: 10px;\\n  padding: 0.55rem 0.9rem;\\n  font-weight: 700;\\n  cursor: pointer;\\n  transition: transform 0.05s ease, box-shadow 0.2s ease;\\n}\\n\\n.admin-button:disabled {\\n  cursor: not-allowed;\\n  opacity: 0.6;\\n  box-shadow: none;\\n}\\n\\n.admin-button[aria-disabled='true'] {\\n  cursor: not-allowed;\\n  opacity: 0.6;\\n  box-shadow: none;\\n}\\n\\n.admin-button[data-guarded='true'] {\\n  filter: grayscale(0.2);\\n}\\n\\n.admin-button--primary {\\n  background: #1d4ed8;\\n  border-color: #1d4ed8;\\n  color: #ffffff;\\n  box-shadow: none;\\n}\\n\\n.admin-button--secondary {\\n  background: #e2e8f0;\\n  color: #0f172a;\\n}\\n\\n.admin-button--danger {\\n  background: #dc2626;\\n  border-color: #dc2626;\\n  color: #ffffff;\\n  box-shadow: none;\\n}\\n\\n.admin-queue {\\n  width: 100%;\\n  border-collapse: collapse;\\n  margin-top: 0.75rem;\\n}\\n\\n.admin-queue th,\\n.admin-queue td {\\n  border-bottom: 1px solid rgba(148, 163, 184, 0.3);\\n  padding: 0.45rem 0.35rem;\\n  text-align: left;\\n}\\n\\n.admin-queue th {\\n  font-weight: 800;\\n  color: #0f172a;\\n}\\n\\n.admin-queue__status {\\n  display: inline-flex;\\n  align-items: center;\\n  padding: 0.25rem 0.55rem;\\n  border-radius: 999px;\\n  font-weight: 700;\\n  font-size: 0.85rem;\\n}\\n\\n.admin-queue__status--pending {\\n  background: #fef3c7;\\n  color: #b45309;\\n}\\n\\n.admin-queue__status--failed {\\n  background: #fee2e2;\\n  color: #b91c1c;\\n}\\n\\n.admin-queue__status--delivered {\\n  background: #d1fae5;\\n  color: #047857;\\n}\\n\\n.admin-queue__actions {\\n  display: inline-flex;\\n  flex-direction: column;\\n  align-items: flex-start;\\n  gap: 0.35rem;\\n}\\n\\n.admin-queue__reason {\\n  margin: 0;\\n  max-width: 20rem;\\n}\\n\\n.admin-note {\\n  background: #e2e8f0;\\n  color: #0f172a;\\n  border-radius: 12px;\\n  padding: 0.5rem 0.75rem;\\n  font-size: 0.9rem;\\n}\\n\\n.admin-delivery-flags {\\n  list-style: none;\\n  padding-left: 0;\\n  margin: 0.75rem 0 0;\\n  display: grid;\\n  gap: 0.4rem;\\n}\\n\\n.admin-delivery-flags__row {\\n  display: grid;\\n  grid-template-columns: minmax(120px, 160px) 1fr auto;\\n  align-items: center;\\n  gap: 0.5rem;\\n  background: #ffffff;\\n  border: 1px solid rgba(148, 163, 184, 0.35);\\n  border-radius: 12px;\\n  padding: 0.4rem 0.6rem;\\n}\\n\\n.admin-delivery-flags__label {\\n  font-weight: 700;\\n  color: #0f172a;\\n}\\n\\n.admin-delivery-flags__value {\\n  color: #475569;\\n  font-size: 0.9rem;\\n}\\n\\n.admin-delivery-pill {\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  border-radius: 999px;\\n  padding: 0.2rem 0.6rem;\\n  font-weight: 700;\\n  font-size: 0.8rem;\\n  white-space: nowrap;\\n  border: 1px solid transparent;\\n}\\n\\n.admin-delivery-pill--applied {\\n  background: #dcfce7;\\n  color: #15803d;\\n  border-color: rgba(21, 128, 61, 0.25);\\n}\\n\\n.admin-delivery-pill--pending {\\n  background: #fef3c7;\\n  color: #b45309;\\n  border-color: rgba(180, 83, 9, 0.25);\\n}\\n\\n.admin-delivery-pill--unknown {\\n  background: #e2e8f0;\\n  color: #475569;\\n  border-color: rgba(71, 85, 105, 0.25);\\n}\\n\\n.admin-alert {\\n  display: grid;\\n  grid-template-columns: auto 1fr;\\n  gap: 0.35rem 0.65rem;\\n  align-items: center;\\n  border-radius: 12px;\\n  padding: 0.75rem 1rem;\\n  border: 1px solid rgba(234, 179, 8, 0.4);\\n  background: #fef9c3;\\n}\\n\\n.admin-alert__tone {\\n  font-weight: 800;\\n  color: #b45309;\\n}\\n\\n.admin-alert__message {\\n  margin: 0;\\n  color: #92400e;\\n}\\n\\n.admin-guard {\\n  display: grid;\\n  gap: 0.45rem;\\n  border-radius: 14px;\\n  border: 1px solid rgba(248, 113, 113, 0.45);\\n  background: #fff1f2;\\n  padding: 0.85rem 1rem;\\n}\\n\\n.admin-guard__header {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.6rem;\\n}\\n\\n.admin-guard__title {\\n  font-weight: 800;\\n  color: #b91c1c;\\n}\\n\\n.admin-guard__badge {\\n  font-size: 0.8rem;\\n  font-weight: 700;\\n  color: #991b1b;\\n  border-radius: 999px;\\n  border: 1px solid rgba(153, 27, 27, 0.35);\\n  padding: 0.15rem 0.5rem;\\n  background: rgba(254, 226, 226, 0.9);\\n}\\n\\n.admin-guard__message {\\n  margin: 0;\\n  color: #7f1d1d;\\n}\\n\\n.admin-guard__next {\\n  margin: 0;\\n  padding-left: 1.2rem;\\n  color: #7f1d1d;\\n  font-size: 0.92rem;\\n}\\n\\n.admin-guard__link {\\n  color: #b91c1c;\\n  font-weight: 700;\\n}\\n\\n.admin-guard__link:hover {\\n  text-decoration: underline;\\n}\\n\\n.admin-quiet {\\n  color: #475569;\\n  font-size: 0.9rem;\\n}\\n\\n.admin-card-shell {\\n  display: grid;\\n  gap: 0.75rem;\\n}\\n\\n.admin-card-shell__header {\\n  display: flex;\\n  align-items: start;\\n  justify-content: space-between;\\n  gap: 0.75rem;\\n}\\n\\n.admin-card-shell__header-main {\\n  display: grid;\\n  gap: 0.35rem;\\n}\\n\\n.admin-card-shell__description {\\n  margin: 0;\\n  color: #475569;\\n  font-size: 0.9rem;\\n}\\n\\n.admin-card-shell__actions {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.5rem;\\n}\\n\\n.admin-card-shell__body {\\n  display: grid;\\n  gap: 0.75rem;\\n}\\n\\n.admin-header-blocks {\\n  display: grid;\\n  gap: 0.75rem;\\n}\\n\\n.admin-header-block {\\n  border: 1px solid rgba(148, 163, 184, 0.35);\\n  border-radius: 12px;\\n  background: #ffffff;\\n  padding: 0.65rem 0.8rem;\\n  display: grid;\\n  gap: 0.5rem;\\n}\\n\\n.admin-header-block h2 {\\n  margin: 0;\\n  font-size: 0.9rem;\\n  color: #1f2937;\\n}\\n\\n.administration-page__feedback {\\n  border-radius: 12px;\\n}\\n\\n.administration-page__pill--warn {\\n  cursor: pointer;\\n  background: #fef3c7;\\n  border-color: rgba(180, 83, 9, 0.35);\\n  color: #92400e;\\n}\\n\\n.admin-pill-copy {\\n  margin-left: 0.4rem;\\n  border: none;\\n  background: rgba(15, 23, 42, 0.08);\\n  color: #0f172a;\\n  border-radius: 999px;\\n  padding: 0.1rem 0.45rem;\\n  font-size: 0.72rem;\\n  cursor: pointer;\\n}\\n\\n.admin-subnav {\\n  display: grid;\\n  gap: 0.45rem;\\n  padding: 0.85rem;\\n  border-radius: 16px;\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface-muted);\\n}\\n\\n.admin-subnav__group {\\n  display: grid;\\n  gap: 0.4rem;\\n}\\n\\n.admin-subnav__group-label {\\n  margin: 0;\\n  font-size: 0.78rem;\\n  font-weight: 800;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: #64748b;\\n}\\n\\n.admin-subnav__item {\\n  border: 1px solid transparent;\\n  background: transparent;\\n  border-radius: 12px;\\n  padding: 0.7rem 0.7rem 0.7rem 0.95rem;\\n  text-align: left;\\n  display: grid;\\n  gap: 0.15rem;\\n  cursor: pointer;\\n  position: relative;\\n  transition: background 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;\\n}\\n\\n.admin-subnav__item.is-active {\\n  border-color: var(--ui-selection-border);\\n  background: var(--ui-selection-bg);\\n  box-shadow: inset 3px 0 0 var(--ui-primary);\\n}\\n\\n.admin-subnav__label {\\n  font-weight: 800;\\n  color: #0f172a;\\n}\\n\\n.admin-subnav__desc {\\n  font-size: 0.8rem;\\n  color: #64748b;\\n}\\n\\n.admin-request-template {\\n  display: grid;\\n  gap: 0.45rem;\\n}\\n\\n.admin-request-template textarea {\\n  width: 100%;\\n  border: 1px solid rgba(148, 163, 184, 0.35);\\n  border-radius: 10px;\\n  padding: 0.55rem 0.65rem;\\n  font-size: 0.85rem;\\n  font-family: 'SFMono-Regular', ui-monospace, Menlo, Monaco, Consolas, monospace;\\n  background: #ffffff;\\n}\\n\\n.admin-group {\\n  display: grid;\\n  gap: 0.55rem;\\n}\\n\\n.admin-group__title {\\n  margin: 0;\\n  font-size: 0.95rem;\\n  color: #1f2937;\\n}\\n\\n.admin-inline-meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.45rem;\\n  align-items: center;\\n}\\n\\n.admin-inline-meta--wrap {\\n  align-items: start;\\n}\\n\\n.admin-dirty-state {\\n  display: flex;\\n  flex-wrap: wrap;\\n  align-items: center;\\n  gap: 0.5rem;\\n  border: 1px dashed rgba(148, 163, 184, 0.45);\\n  border-radius: 10px;\\n  padding: 0.45rem 0.55rem;\\n  background: #ffffff;\\n}\\n\\n.admin-dirty-state__updated {\\n  color: #475569;\\n  font-size: 0.86rem;\\n}\\n\\n.admin-field__required {\\n  margin-left: 0.25rem;\\n  color: #b91c1c;\\n  font-weight: 800;\\n}\\n\\n.admin-field__error {\\n  margin: 0;\\n  color: #b91c1c;\\n  font-size: 0.84rem;\\n  font-weight: 700;\\n}\\n\\n.admin-code-block {\\n  display: grid;\\n  gap: 0.45rem;\\n}\\n\\n.admin-code-block__header {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.45rem;\\n  align-items: center;\\n}\\n\\n.admin-code-block__toggle {\\n  padding-inline: 0.7rem;\\n}\\n\\n.admin-code-block__meta {\\n  color: #64748b;\\n  font-size: 0.78rem;\\n}\\n\\n.admin-code-block__pre {\\n  margin: 0;\\n  max-height: 300px;\\n  overflow: auto;\\n  border-radius: 10px;\\n  border: 1px solid rgba(148, 163, 184, 0.35);\\n  background: #0f172a;\\n  color: #f8fafc;\\n  padding: 0.6rem 0.7rem;\\n  font-size: 0.8rem;\\n}\\n\\n.admin-dialog {\\n  display: grid;\\n  gap: 0.75rem;\\n}\\n\\n.admin-dialog__actions {\\n  display: flex;\\n  justify-content: flex-end;\\n  gap: 0.5rem;\\n}\\n\\n.admin-dev-flags {\\n  border: 1px dashed rgba(148, 163, 184, 0.45);\\n  border-radius: 10px;\\n  padding: 0.55rem 0.65rem;\\n  background: #ffffff;\\n}\\n\\n.admin-dev-flags > summary {\\n  cursor: pointer;\\n  font-weight: 700;\\n  color: #334155;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.admin-kpi-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\\n  gap: 0.6rem;\\n}\\n\\n.admin-kpi-grid__item {\\n  border: 1px solid rgba(148, 163, 184, 0.25);\\n  border-radius: 10px;\\n  padding: 0.45rem 0.6rem;\\n  background: #ffffff;\\n  display: grid;\\n  gap: 0.2rem;\\n}\\n\\n.admin-kpi-grid__label {\\n  font-weight: 700;\\n  color: #334155;\\n  font-size: 0.84rem;\\n}\\n\\n.admin-queue-tools {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n}\\n\\n.admin-queue-tools select {\\n  border: 1px solid rgba(148, 163, 184, 0.75);\\n  border-radius: 10px;\\n  padding: 0.35rem 0.5rem;\\n}\\n\\n.admin-queue__row--delayed {\\n  background: #fff7ed;\\n}\\n\\n.admin-scroll--sticky .admin-table th {\\n  position: sticky;\\n  top: 0;\\n  z-index: 1;\\n}\\n\\n.admin-table--diff td,\\n.admin-table--diff th {\\n  vertical-align: top;\\n}\\n\\n.admin-table--compact th,\\n.admin-table--compact td {\\n  font-size: 0.82rem;\\n}\\n\\n.admin-row--pending {\\n  background: #fef3c7;\\n}\\n\\n.admin-row--selected {\\n  background: #dbeafe;\\n}\\n\\n.admin-touch-panel__header {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 0.75rem;\\n}\\n\\n.admin-touch-panel__badge {\\n  font-size: 0.8rem;\\n  font-weight: 700;\\n  border-radius: 999px;\\n  padding: 0.2rem 0.6rem;\\n  background: #e0f2fe;\\n  color: #0c4a6e;\\n  border: 1px solid rgba(12, 74, 110, 0.2);\\n}\\n\\n.admin-touch-panel__filters {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\\n  gap: 0.75rem;\\n  margin-top: 0.75rem;\\n}\\n\\n.admin-touch-panel__group {\\n  margin-top: 1rem;\\n}\\n\\n.admin-touch-panel__group-header {\\n  display: flex;\\n  align-items: baseline;\\n  justify-content: space-between;\\n  gap: 0.5rem;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.admin-touch-panel__group-title {\\n  margin: 0;\\n  font-size: 1rem;\\n  font-weight: 700;\\n  color: #0f172a;\\n}\\n\\n.admin-touch-panel__group-count {\\n  font-size: 0.8rem;\\n  color: #64748b;\\n}\\n\\n.admin-touch-panel__list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 1rem;\\n}\\n\\n.admin-touch-panel__row {\\n  display: grid;\\n  grid-template-columns: minmax(220px, 1fr) minmax(220px, 0.6fr);\\n  gap: 1rem;\\n  border-radius: 12px;\\n  padding: 0.85rem;\\n  border: 1px solid rgba(148, 163, 184, 0.2);\\n  background: #f8fafc;\\n}\\n\\n.admin-touch-panel__meta {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.35rem;\\n}\\n\\n.admin-touch-panel__title {\\n  display: flex;\\n  align-items: center;\\n  flex-wrap: wrap;\\n  gap: 0.5rem;\\n  font-weight: 700;\\n  color: #0f172a;\\n}\\n\\n.admin-touch-panel__method {\\n  font-size: 0.75rem;\\n  font-weight: 700;\\n  padding: 0.15rem 0.45rem;\\n  border-radius: 999px;\\n  background: #e2e8f0;\\n  color: #0f172a;\\n}\\n\\n.admin-touch-panel__stub {\\n  font-size: 0.7rem;\\n  font-weight: 700;\\n  padding: 0.1rem 0.4rem;\\n  border-radius: 999px;\\n  background: #fef3c7;\\n  color: #92400e;\\n}\\n\\n.admin-touch-panel__description {\\n  margin: 0;\\n  color: #475569;\\n  font-size: 0.85rem;\\n}\\n\\n.admin-touch-panel__summary {\\n  margin: 0;\\n  font-size: 0.85rem;\\n  color: #1f2937;\\n}\\n\\n.admin-touch-panel__summary.is-success {\\n  color: #15803d;\\n}\\n\\n.admin-touch-panel__summary.is-error {\\n  color: #b91c1c;\\n}\\n\\n.admin-touch-panel__timestamp {\\n  margin: 0;\\n  font-size: 0.75rem;\\n  color: #64748b;\\n}\\n\\n.admin-touch-panel__error {\\n  margin: 0;\\n  font-size: 0.8rem;\\n  color: #b91c1c;\\n}\\n\\n.admin-touch-panel__actions {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.6rem;\\n  align-items: stretch;\\n  justify-content: center;\\n}\\n\\n@media (max-width: 960px) {\\n  .admin-touch-panel__row {\\n    grid-template-columns: 1fr;\\n  }\\n}\\n\\n@media (max-width: 720px) {\\n  .administration-page {\\n    padding: 1rem;\\n  }\\n  .administration-page__masthead {\\n    grid-template-columns: 1fr;\\n  }\\n  .administration-page__workspace--delivery {\\n    grid-template-columns: 1fr;\\n  }\\n  .administration-tabs {\\n    flex-direction: column;\\n  }\\n  .admin-form__toggles {\\n    grid-template-columns: 1fr;\\n  }\\n  .admin-delivery-flags__row {\\n    grid-template-columns: 1fr;\\n    align-items: start;\\n  }\\n  .admin-summary__row {\\n    grid-template-columns: 1fr;\\n  }\\n  .admin-card-shell__header {\\n    flex-direction: column;\\n  }\\n}\\n\\n/* Administration UI guideline normalization */\\n.administration-page {\\n  --admin-radius-tab: 8px;\\n  --admin-radius-input: 8px;\\n  --admin-radius-card: 12px;\\n  --admin-radius-modal: 16px;\\n}\\n\\n.administration-page,\\n.administration-card,\\n.admin-toggle,\\n.admin-result,\\n.admin-callout,\\n.admin-warning-box,\\n.admin-note,\\n.admin-delivery-flags__row,\\n.admin-alert,\\n.admin-guard,\\n.admin-header-block,\\n.admin-subnav__item,\\n.admin-scroll,\\n.admin-touch-panel__row,\\n.admin-kpi-grid__item,\\n.admin-dirty-state,\\n.admin-dev-flags {\\n  border-radius: var(--admin-radius-card);\\n}\\n\\n.admin-dialog {\\n  border-radius: var(--admin-radius-modal);\\n}\\n\\n.administration-tabs {\\n  gap: 0.45rem;\\n}\\n\\n.administration-tab {\\n  border-radius: var(--admin-radius-tab);\\n  border: 1px solid transparent;\\n  border-bottom: 0;\\n  background: transparent;\\n  color: #0f172a;\\n  font-weight: 700;\\n}\\n\\n.administration-tab:hover,\\n.administration-tab:focus-visible {\\n  transform