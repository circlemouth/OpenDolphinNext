            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/styles/app-shell.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"/Users/Hayato/Documents/GitHub/OpenDolphin_WebClient/web-client/src/styles/app-shell.css\"\nconst __vite__css = \".app-shell {\\n  display: flex;\\n  flex-direction: column;\\n  min-height: 100dvh;\\n  background: var(--ui-bg);\\n  color: var(--ui-text);\\n}\\n\\n.app-shell__topbar {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  gap: 1rem;\\n  padding: 1rem clamp(1rem, 4vw, 2.5rem) 0.75rem;\\n  border-bottom: 1px solid var(--ui-border-subtle);\\n  background: var(--ui-surface);\\n}\\n\\n.app-shell__brand {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.15rem;\\n}\\n\\n.app-shell__title {\\n  font-weight: 800;\\n  letter-spacing: 0.02em;\\n  font-size: 1.2rem;\\n}\\n\\n.app-shell__subtitle {\\n  margin: 0;\\n  color: var(--ui-text-muted);\\n}\\n\\n.app-shell__session {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  flex-wrap: wrap;\\n  justify-content: flex-end;\\n}\\n\\n.app-shell__pill {\\n  background: var(--ui-surface-muted);\\n  border: 1px solid var(--ui-border);\\n  border-radius: 8px;\\n  padding: 0.35rem 0.8rem;\\n  font-size: 0.9rem;\\n  color: var(--ui-text);\\n  position: relative;\\n}\\n.app-shell__pill--fixed {\\n  white-space: nowrap;\\n}\\n.app-shell__pill.is-clickable {\\n  cursor: pointer;\\n  transition: box-shadow 0.2s ease;\\n}\\n.app-shell__pill.is-clickable:hover {\\n  border-color: var(--ui-primary);\\n  box-shadow: 0 10px 24px rgba(29, 78, 216, 0.16);\\n}\\n\\n.app-shell__debug-copy {\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface);\\n  color: var(--ui-text-muted);\\n  padding: 0.35rem 0.7rem;\\n  min-height: 32px;\\n  border-radius: 8px;\\n  font-size: 0.78rem;\\n  font-weight: 700;\\n  cursor: pointer;\\n  transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;\\n}\\n\\n.app-shell__debug-copy:hover,\\n.app-shell__debug-copy:focus-visible {\\n  background: var(--ui-surface-muted);\\n  border-color: var(--ui-border-strong);\\n  box-shadow: 0 8px 16px rgba(15, 23, 42, 0.08);\\n  outline: none;\\n}\\n\\n.app-shell__logout {\\n  border: 1px solid #dc2626;\\n  background: #dc2626;\\n  color: var(--ui-primary-contrast);\\n  padding: 0.5rem 0.95rem;\\n  min-height: 36px;\\n  border-radius: 8px;\\n  font-weight: 700;\\n  cursor: pointer;\\n  box-shadow: 0 8px 18px rgba(220, 38, 38, 0.22);\\n  transition: box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;\\n}\\n\\n.app-shell__logout:hover,\\n.app-shell__logout:focus-visible {\\n  background: #b91c1c;\\n  border-color: #b91c1c;\\n  box-shadow: 0 12px 22px rgba(220, 38, 38, 0.24);\\n  outline: none;\\n}\\n\\n.app-shell__switch {\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface);\\n  color: var(--ui-text);\\n  padding: 0.5rem 0.95rem;\\n  min-height: 36px;\\n  border-radius: 8px;\\n  font-weight: 700;\\n  cursor: pointer;\\n  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.07);\\n  transition: box-shadow 0.15s ease, border-color 0.15s ease;\\n}\\n\\n.app-shell__switch:hover,\\n.app-shell__switch:focus-visible {\\n  border-color: var(--ui-primary);\\n  box-shadow: 0 12px 24px rgba(29, 78, 216, 0.16);\\n  outline: none;\\n}\\n\\n.app-shell__admin {\\n  border: 1px solid var(--ui-primary);\\n  background: var(--ui-primary);\\n  color: var(--ui-primary-contrast);\\n  padding: 0.5rem 0.95rem;\\n  min-height: 36px;\\n  border-radius: 8px;\\n  font-weight: 800;\\n  cursor: pointer;\\n  box-shadow: 0 8px 18px rgba(29, 78, 216, 0.22);\\n  transition: box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;\\n}\\n.app-shell__admin:hover,\\n.app-shell__admin:focus-visible {\\n  background: #1e40af;\\n  border-color: #1e40af;\\n  box-shadow: 0 14px 26px rgba(29, 78, 216, 0.28);\\n  outline: none;\\n}\\n\\n.app-shell__tools {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n}\\n\\n.app-shell__tool {\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface);\\n  color: var(--ui-text);\\n  padding: 0.5rem 0.85rem;\\n  min-height: 36px;\\n  border-radius: 8px;\\n  font-weight: 800;\\n  cursor: pointer;\\n  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.45rem;\\n  transition: box-shadow 0.15s ease, border-color 0.15s ease, background 0.15s ease;\\n}\\n\\n.app-shell__tool:hover,\\n.app-shell__tool:focus-visible {\\n  box-shadow: 0 12px 22px rgba(15, 23, 42, 0.12);\\n  border-color: var(--ui-primary);\\n}\\n\\n.app-shell__tool-icon {\\n  width: 18px;\\n  height: 18px;\\n}\\n\\n.app-shell__tool--reception {\\n  background: var(--ui-surface);\\n  border-color: var(--ui-border);\\n  color: var(--ui-text);\\n}\\n\\n.app-shell__tool--patients {\\n  background: var(--ui-surface);\\n  border-color: var(--ui-border);\\n  color: var(--ui-text);\\n}\\n\\n.app-shell__tool--charts {\\n  background: var(--ui-surface);\\n  border-color: var(--ui-border);\\n  color: var(--ui-text);\\n}\\n\\n.app-shell__tool--reception .app-shell__tool-icon {\\n  color: var(--ui-module-reception);\\n}\\n\\n.app-shell__tool--patients .app-shell__tool-icon {\\n  color: var(--ui-module-patients);\\n}\\n\\n.app-shell__tool--charts .app-shell__tool-icon {\\n  color: var(--ui-module-charts);\\n}\\n\\n.app-shell__tool[aria-current='page'] {\\n  border-color: var(--ui-selected-border);\\n  background: var(--ui-selected-bg);\\n  box-shadow:\\n    inset 3px 0 0 var(--ui-selected-rail),\\n    0 10px 20px rgba(15, 23, 42, 0.1);\\n  font-weight: 800;\\n  color: var(--ui-text);\\n}\\n\\n.app-shell__nav {\\n  display: flex;\\n  gap: 0.5rem;\\n  padding: 0 1.25rem 0.75rem;\\n  border-bottom: 1px solid var(--ui-border);\\n  background: var(--ui-surface);\\n}\\n\\n.app-shell__mock-banner {\\n  margin: 0.75rem 1.25rem 0;\\n  border-radius: 14px;\\n}\\n\\n.app-shell__tabbar {\\n  margin: 0.65rem 1.25rem 0;\\n  padding: 0.45rem;\\n  border: 1px solid var(--ui-border);\\n  border-radius: 12px;\\n  background: var(--ui-surface);\\n  position: relative;\\n  z-index: 2;\\n}\\n\\n.workspace-tabs {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  min-width: 0;\\n}\\n\\n.workspace-tabs__fixed {\\n  display: inline-flex;\\n  gap: 0.4rem;\\n  flex-wrap: wrap;\\n}\\n\\n.workspace-tabs__dynamic-area {\\n  min-width: 0;\\n  flex: 1 1 auto;\\n  display: flex;\\n  align-items: center;\\n  gap: 0.35rem;\\n}\\n\\n.workspace-tabs__dynamic-controls {\\n  min-width: 0;\\n  flex: 1 1 auto;\\n  display: flex;\\n  align-items: center;\\n  gap: 0.3rem;\\n}\\n\\n.workspace-tabs__dynamic {\\n  min-width: 0;\\n  flex: 1 1 auto;\\n  display: flex;\\n  align-items: center;\\n  gap: 0.35rem;\\n  overflow-x: auto;\\n  overflow-y: hidden;\\n  white-space: nowrap;\\n  scroll-behavior: smooth;\\n  scrollbar-width: thin;\\n}\\n\\n.workspace-tabs__scroll-btn {\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface);\\n  color: var(--ui-text);\\n  border-radius: 8px;\\n  min-height: 34px;\\n  min-width: 34px;\\n  padding: 0;\\n  font-weight: 800;\\n  cursor: pointer;\\n}\\n\\n.workspace-tabs__scroll-btn:hover,\\n.workspace-tabs__scroll-btn:focus-visible {\\n  border-color: var(--ui-primary);\\n  box-shadow: 0 10px 18px rgba(29, 78, 216, 0.14);\\n  outline: none;\\n}\\n\\n.workspace-tabs__scroll-btn:disabled {\\n  opacity: 0.4;\\n  cursor: default;\\n  box-shadow: none;\\n}\\n\\n.workspace-tabs__item {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.25rem;\\n  min-width: 0;\\n}\\n\\n.workspace-tabs__tab {\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface);\\n  color: var(--ui-text);\\n  border-radius: 8px;\\n  min-height: 34px;\\n  padding: 0.35rem 0.8rem;\\n  font-size: 0.86rem;\\n  font-weight: 700;\\n  line-height: 1.1;\\n  cursor: pointer;\\n  white-space: nowrap;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  max-width: 220px;\\n  transition: border-color 0.15s ease, box-shadow 0.15s ease;\\n}\\n\\n.workspace-tabs__tab--patient {\\n  display: inline-flex;\\n  align-items: flex-start;\\n  gap: 0.55rem;\\n  min-height: 44px;\\n  padding-block: 0.45rem;\\n  max-width: 280px;\\n  white-space: normal;\\n}\\n\\n.workspace-tabs__tab-labels {\\n  min-width: 0;\\n  display: flex;\\n  flex-direction: column;\\n  align-items: flex-start;\\n  gap: 0.14rem;\\n}\\n\\n.workspace-tabs__tab-primary,\\n.workspace-tabs__tab-secondary {\\n  display: block;\\n  max-width: 100%;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.workspace-tabs__tab-primary {\\n  font-weight: 800;\\n}\\n\\n.workspace-tabs__tab-secondary {\\n  color: var(--ui-text-muted);\\n  font-size: 0.74rem;\\n}\\n\\n.workspace-tabs__tab:hover,\\n.workspace-tabs__tab:focus-visible {\\n  border-color: var(--ui-primary);\\n  box-shadow: 0 10px 18px rgba(29, 78, 216, 0.14);\\n  outline: none;\\n}\\n\\n.workspace-tabs__tab.is-active {\\n  border-color: var(--ui-selected-border);\\n  background: var(--ui-selected-bg);\\n  color: var(--ui-primary);\\n  box-shadow: inset 3px 0 0 var(--ui-selected-rail);\\n  font-weight: 700;\\n}\\n\\n.workspace-tabs__tab--shortcut {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.45rem;\\n  min-height: 36px;\\n  padding: 0.5rem 0.85rem;\\n  border-radius: 8px;\\n  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);\\n  text-decoration: none;\\n}\\n\\n.workspace-tabs__tab--shortcut:hover,\\n.workspace-tabs__tab--shortcut:focus-visible {\\n  box-shadow: 0 12px 22px rgba(15, 23, 42, 0.12);\\n}\\n\\n.workspace-tabs__tab--shortcut.is-active {\\n  border-color: var(--ui-selected-border);\\n  background: var(--ui-selected-bg);\\n  box-shadow:\\n    inset 3px 0 0 var(--ui-selected-rail),\\n    0 10px 20px rgba(15, 23, 42, 0.1);\\n  font-weight: 700;\\n}\\n\\n.workspace-tabs__tab--reception {\\n  color: var(--ui-text);\\n}\\n\\n.workspace-tabs__tab--chart {\\n  color: var(--ui-text);\\n}\\n\\n.workspace-tabs__tab--patients {\\n  color: var(--ui-text);\\n}\\n\\n.workspace-tabs__tab--reception .workspace-tabs__tab-icon {\\n  color: var(--ui-module-reception);\\n}\\n\\n.workspace-tabs__tab--chart .workspace-tabs__tab-icon {\\n  color: var(--ui-module-charts);\\n}\\n\\n.workspace-tabs__tab--patients .workspace-tabs__tab-icon {\\n  color: var(--ui-module-patients);\\n}\\n\\n.workspace-tabs__tab-icon {\\n  width: 18px;\\n  height: 18px;\\n  flex: 0 0 auto;\\n}\\n\\n.workspace-tabs__close {\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface-muted);\\n  color: var(--ui-text-muted);\\n  border-radius: 8px;\\n  min-height: 30px;\\n  min-width: 30px;\\n  padding: 0;\\n  cursor: pointer;\\n  font-size: 0.95rem;\\n  line-height: 1;\\n  transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;\\n}\\n\\n.workspace-tabs__close:hover,\\n.workspace-tabs__close:focus-visible {\\n  border-color: #dc2626;\\n  background: #fef2f2;\\n  color: #b91c1c;\\n  outline: none;\\n}\\n\\n.workspace-tabs__overflow {\\n  position: relative;\\n  flex: 0 0 auto;\\n}\\n\\n.workspace-tabs__overflow-toggle {\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface);\\n  color: var(--ui-text);\\n  border-radius: 8px;\\n  min-height: 34px;\\n  padding: 0.35rem 0.65rem;\\n  font-weight: 800;\\n  cursor: pointer;\\n}\\n\\n.workspace-tabs__overflow-toggle:hover,\\n.workspace-tabs__overflow-toggle:focus-visible {\\n  border-color: var(--ui-primary);\\n  box-shadow: 0 10px 18px rgba(29, 78, 216, 0.14);\\n  outline: none;\\n}\\n\\n.workspace-tabs__overflow-panel {\\n  position: absolute;\\n  right: 0;\\n  top: calc(100% + 0.35rem);\\n  width: min(420px, calc(100vw - 3rem));\\n  max-height: min(55vh, 420px);\\n  overflow: auto;\\n  border: 1px solid var(--ui-border);\\n  border-radius: 12px;\\n  background: var(--ui-surface);\\n  box-shadow: 0 18px 30px rgba(15, 23, 42, 0.18);\\n  padding: 0.45rem;\\n  display: grid;\\n  gap: 0.35rem;\\n  z-index: 12;\\n}\\n\\n.workspace-tabs__overflow-entry {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.35rem;\\n}\\n\\n.workspace-tabs__actions {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.4rem;\\n  margin-left: auto;\\n  flex-wrap: wrap;\\n  justify-content: flex-end;\\n}\\n\\n.app-shell__nav-runid {\\n  margin-left: auto;\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.4rem;\\n  padding: 0.45rem 0.6rem;\\n  border-radius: 8px;\\n  background: var(--ui-surface-muted);\\n  border: 1px dashed var(--ui-border-strong);\\n  font-weight: 700;\\n  color: var(--ui-text);\\n}\\n\\n.app-shell__nav-copy {\\n  border: 1px solid var(--ui-primary);\\n  background: var(--ui-primary);\\n  color: var(--ui-primary-contrast);\\n  padding: 0.2rem 0.5rem;\\n  min-height: 28px;\\n  border-radius: 8px;\\n  font-size: 0.72rem;\\n  font-weight: 700;\\n  cursor: pointer;\\n  transition: box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;\\n}\\n\\n.app-shell__nav-copy:hover,\\n.app-shell__nav-copy:focus-visible {\\n  background: #1e40af;\\n  border-color: #1e40af;\\n  box-shadow: 0 8px 16px rgba(29, 78, 216, 0.28);\\n  outline: none;\\n}\\n\\n.runid-badge {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.4rem;\\n  padding: 0.35rem 0.65rem;\\n  border-radius: 8px;\\n  border: 1px solid var(--ui-info-border);\\n  background: var(--ui-info-bg);\\n  color: var(--ui-info-text);\\n  font-size: 0.85rem;\\n  font-weight: 600;\\n}\\n\\n.runid-badge__label {\\n  font-size: 0.68rem;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: var(--ui-text-muted);\\n}\\n\\n.runid-badge__value {\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.runid-badge__copy {\\n  border: 1px solid var(--ui-primary);\\n  background: var(--ui-primary);\\n  color: var(--ui-primary-contrast);\\n  padding: 0.2rem 0.55rem;\\n  min-height: 28px;\\n  border-radius: 8px;\\n  font-size: 0.7rem;\\n  font-weight: 700;\\n  cursor: pointer;\\n  transition: box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;\\n}\\n\\n.runid-badge__copy:hover,\\n.runid-badge__copy:focus-visible {\\n  background: #1e40af;\\n  border-color: #1e40af;\\n  box-shadow: 0 8px 16px rgba(29, 78, 216, 0.28);\\n  outline: none;\\n}\\n\\n.app-shell__nav-link {\\n  text-decoration: none;\\n  padding: 0.65rem 1rem;\\n  border-radius: 8px;\\n  color: var(--ui-text);\\n  font-weight: 700;\\n  background: var(--ui-surface);\\n  border: 1px solid var(--ui-border);\\n  transition: all 0.2s ease;\\n  position: relative;\\n}\\n\\n.app-shell__nav-link.has-badge {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.4rem;\\n}\\n\\n.app-shell__nav-link:hover {\\n  border-color: var(--ui-primary);\\n  background: var(--ui-surface-muted);\\n  box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);\\n}\\n\\n.app-shell__nav-link.is-active {\\n  background: var(--ui-selected-bg);\\n  color: var(--ui-primary);\\n  border-color: var(--ui-selected-border);\\n  box-shadow:\\n    inset 3px 0 0 var(--ui-selected-rail),\\n    0 12px 22px rgba(15, 23, 42, 0.1);\\n  font-weight: 800;\\n}\\n\\n.app-shell__nav-link.is-disabled {\\n  color: #94a3b8;\\n  background: var(--ui-surface-muted);\\n  border-color: var(--ui-border);\\n  cursor: not-allowed;\\n  box-shadow: none;\\n}\\n.app-shell__nav-link.is-disabled:hover::after,\\n.app-shell__nav-link.is-disabled:focus-visible::after {\\n  opacity: 1;\\n  transform: translate(-50%, -8px);\\n}\\n.app-shell__nav-link[data-tooltip]::after {\\n  content: attr(data-tooltip);\\n  position: absolute;\\n  left: 50%;\\n  bottom: 100%;\\n  transform: translate(-50%, -4px);\\n  background: rgba(15, 23, 42, 0.95);\\n  color: #f8fafc;\\n  padding: 0.4rem 0.65rem;\\n  border-radius: 8px;\\n  font-size: 0.72rem;\\n  font-weight: 600;\\n  white-space: nowrap;\\n  pointer-events: none;\\n  opacity: 0;\\n  transition: opacity 0.2s ease, transform 0.2s ease;\\n  z-index: 5;\\n}\\n\\n.app-shell__nav-badge {\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  padding: 0.1rem 0.4rem;\\n  border-radius: 999px;\\n  font-size: 0.7rem;\\n  font-weight: 800;\\n  letter-spacing: 0.02em;\\n}\\n\\n.app-shell__nav-badge--warning {\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  border: 1px solid var(--ui-warning-border);\\n}\\n\\n.app-shell__nav-badge--info {\\n  background: var(--ui-info-bg);\\n  color: var(--ui-info-text);\\n  border: 1px solid var(--ui-info-border);\\n}\\n\\n.app-shell__nav-label {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.3rem;\\n}\\n\\n.app-shell__body {\\n  flex: 1;\\n  min-height: 0;\\n  overflow: auto;\\n  padding: 0 1.25rem 2rem;\\n}\\n\\n.app-shell__crash-fallback {\\n  margin-top: 1rem;\\n}\\n\\n.app-shell__crash-actions {\\n  display: flex;\\n  gap: 0.5rem;\\n  flex-wrap: wrap;\\n}\\n\\n.app-shell__notice-stack {\\n  position: fixed;\\n  right: 16px;\\n  top: clamp(108px, 16vh, 190px);\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n  max-width: min(340px, 92vw);\\n  z-index: 120;\\n}\\n\\n.app-shell__notice {\\n  position: relative;\\n  padding: 12px 14px 12px 12px;\\n  border-radius: 12px;\\n  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.25);\\n  font-size: 0.9rem;\\n  border: 1px solid transparent;\\n  display: grid;\\n  gap: 0.25rem;\\n  background: rgba(15, 23, 42, 0.9);\\n  color: #f8fafc;\\n}\\n\\n.app-shell__notice--info {\\n  background: rgba(30, 64, 175, 0.92);\\n  border-color: rgba(147, 197, 253, 0.4);\\n}\\n\\n.app-shell__notice--success {\\n  background: rgba(21, 128, 61, 0.92);\\n  border-color: rgba(134, 239, 172, 0.4);\\n}\\n\\n.app-shell__notice--warning {\\n  background: rgba(180, 83, 9, 0.92);\\n  border-color: rgba(253, 230, 138, 0.5);\\n}\\n\\n.app-shell__notice--error {\\n  background: rgba(185, 28, 28, 0.92);\\n  border-color: rgba(254, 202, 202, 0.5);\\n}\\n\\n.app-shell__notice-message {\\n  font-weight: 700;\\n}\\n\\n.app-shell__notice-detail {\\n  font-size: 0.78rem;\\n  opacity: 0.9;\\n}\\n\\n.app-shell__notice-close {\\n  position: absolute;\\n  right: 6px;\\n  top: 4px;\\n  border: none;\\n  background: transparent;\\n  color: inherit;\\n  font-size: 1rem;\\n  cursor: pointer;\\n}\\n\\n.placeholder-page {\\n  background: #ffffff;\\n  border: 1px solid rgba(148, 163, 184, 0.25);\\n  border-radius: 16px;\\n  padding: 1.5rem;\\n  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);\\n}\\n\\n.placeholder-page__lead {\\n  color: #0f172a;\\n  margin-bottom: 0.75rem;\\n}\\n\\n.placeholder-page__list {\\n  padding-left: 1.2rem;\\n  color: #334155;\\n  line-height: 1.6;\\n}\\n.access-denied {\\n  background: #fef2f2;\\n  border: 1px solid rgba(239, 68, 68, 0.35);\\n  color: #991b1b;\\n  border-radius: 14px;\\n  padding: 1rem 1.25rem;\\n  box-shadow: 0 8px 24px rgba(239, 68, 68, 0.15);\\n}\\n\\n.access-denied__title {\\n  margin: 0 0 0.25rem;\\n  font-weight: 800;\\n}\\n\\n.access-denied__reason {\\n  margin: 0 0 0.5rem;\\n}\\n\\n.access-denied__redirect a {\\n  font-weight: 700;\\n  color: #b91c1c;\\n  text-decoration: underline;\\n}\\n\\n@media (max-width: 720px) {\\n  .app-shell__topbar {\\n    flex-direction: column;\\n    align-items: flex-start;\\n  }\\n\\n  .app-shell__session {\\n    width: 100%;\\n    justify-content: flex-start;\\n  }\\n\\n  .app-shell__nav {\\n    flex-wrap: wrap;\\n  }\\n\\n  .app-shell__nav-runid {\\n    width: 100%;\\n    margin-left: 0;\\n    justify-content: space-between;\\n  }\\n\\n  .app-shell__notice-stack {\\n    right: 12px;\\n    left: 12px;\\n    top: clamp(140px, 24vh, 240px);\\n    max-width: none;\\n  }\\n\\n  .app-shell__tabbar {\\n    margin-left: 1rem;\\n    margin-right: 1rem;\\n  }\\n\\n  .workspace-tabs {\\n    flex-direction: column;\\n    align-it