  { id: \"\", label: \"未設定\" },\n  { id: \"doctor\", label: \"医師\" },\n  { id: \"nurse\", label: \"看護師\" },\n  { id: \"reception\", label: \"受付\" },\n  { id: \"clerk\", label: \"事務\" },\n  { id: \"office\", label: \"事務（office）\" },\n  { id: \"admin\", label: \"管理者\" },\n  { id: \"other\", label: \"その他\" }\n];\nconst SEX_OPTIONS = [\n  { id: \"\", label: \"未設定\" },\n  { id: \"M\", label: \"M (male)\" },\n  { id: \"F\", label: \"F (female)\" },\n  { id: \"O\", label: \"O (other/unknown)\" }\n];\nconst toErrorMessage = (error) => error instanceof Error ? error.message : String(error);\nconst normalizeRoles = (roles) => {\n  const set = new Set((roles ?? []).map((r) => (r ?? \"\").trim()).filter(Boolean));\n  set.add(\"user\");\n  const list = Array.from(set);\n  list.sort((a, b) => {\n    const rank = (v) => v === \"admin\" || v === \"system-administrator\" ? 0 : v === \"doctor\" ? 1 : 2;\n    const ra = rank(a);\n    const rb = rank(b);\n    if (ra !== rb) return ra - rb;\n    return a.localeCompare(b);\n  });\n  return list;\n};\nconst buildEmptyCreateDraft = () => ({\n  loginId: \"\",\n  password: \"\",\n  displayName: \"\",\n  sirName: \"\",\n  givenName: \"\",\n  email: \"\",\n  sex: \"\",\n  staffRole: \"\",\n  roles: [\"user\"]\n});\nconst buildEditDraft = (user) => ({\n  displayName: user.displayName ?? \"\",\n  sirName: user.sirName ?? \"\",\n  givenName: user.givenName ?? \"\",\n  email: user.email ?? \"\",\n  sex: user.sex ?? \"\",\n  staffRole: user.staffRole ?? \"\",\n  roles: normalizeRoles(user.roles)\n});\nexport function AccessManagementPanel({ runId, role, mode = \"full\" }) {\n  _s();\n  const session = useSession();\n  const queryClient = useQueryClient();\n  const isSystemAdmin = isSystemAdminRole(role ?? session.role);\n  const linkedOnlyMode = mode === \"linked-only\";\n  const infoLive = resolveAriaLive(\"info\");\n  const [keyword, setKeyword] = useState(\"\");\n  const [feedback, setFeedback] = useState(null);\n  const [createOpen, setCreateOp