\n  flex-wrap: wrap;\\n}\\n\\n.patient-identity-bar__headline {\\n  min-width: 0;\\n  display: grid;\\n  gap: 0.18rem;\\n}\\n\\n.patient-identity-bar__eyebrow {\\n  margin: 0;\\n  font-size: 0.72rem;\\n  letter-spacing: 0.1em;\\n  text-transform: uppercase;\\n  color: var(--ui-text-muted);\\n  font-weight: 800;\\n}\\n\\n.patient-identity-bar__title-row {\\n  display: flex;\\n  align-items: baseline;\\n  gap: 0.6rem;\\n  flex-wrap: wrap;\\n}\\n\\n.patient-identity-bar__title {\\n  margin: 0;\\n  font-size: clamp(1.05rem, 1.8vw, 1.4rem);\\n  line-height: 1.2;\\n  color: var(--ui-text);\\n}\\n\\n.patient-identity-bar__name {\\n  margin: 0;\\n  color: var(--ui-text-muted);\\n  font-size: 0.9rem;\\n  font-weight: 600;\\n}\\n\\n.patient-identity-bar__id {\\n  display: inline-flex;\\n  align-items: center;\\n  min-height: 1.8rem;\\n  padding: 0.15rem 0.55rem;\\n  border-radius: var(--ui-radius-sm);\\n  border: 1px solid rgba(148, 163, 184, 0.24);\\n  background: rgba(248, 250, 252, 0.96);\\n  font-size: 0.78rem;\\n  font-weight: 800;\\n  color: var(--ui-text-muted);\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.patient-identity-bar__kana {\\n  margin: 0;\\n  color: var(--ui-text-muted);\\n  font-size: 0.88rem;\\n}\\n\\n.patient-identity-bar__actions {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.45rem;\\n  flex-wrap: wrap;\\n  justify-content: flex-end;\\n}\\n\\n.patient-identity-bar__meta {\\n  width: 100%;\\n}\\n\\n.patient-identity-bar__supporting-copy {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.4rem 0.8rem;\\n  color: var(--ui-text-muted);\\n  font-size: 0.84rem;\\n}\\n\\n.patient-identity-bar__supporting-item {\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.patient-identity-bar__chips {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.4rem;\\n}\\n\\n.patient-identity-bar__supporting {\\n  display: grid;\\n  gap: 0.45rem;\\n  padding-top: 0.2rem;\\n  border-top: 1px solid rgba(226, 232, 240, 0.95);\\n}\\n\\n@media (max-width: 720px) {