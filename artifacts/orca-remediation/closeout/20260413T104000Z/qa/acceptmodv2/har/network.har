            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/styles/global.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"/Users/Hayato/Documents/GitHub/OpenDolphin_WebClient/web-client/src/styles/global.css\"\nconst __vite__css = \":root {\\n  --ui-font-sans:\\n    'Hiragino Sans',\\n    'Hiragino Kaku Gothic ProN',\\n    'Yu Gothic UI',\\n    'Yu Gothic',\\n    'Meiryo',\\n    'Noto Sans JP',\\n    'Segoe UI',\\n    system-ui,\\n    -apple-system,\\n    sans-serif;\\n  font-family: var(--ui-font-sans);\\n  --ui-base-font-size: 16px;\\n  color: var(--ui-text);\\n  background-color: var(--ui-bg);\\n  --ui-bg: #f6f7f9;\\n  --ui-surface: #ffffff;\\n  --ui-surface-muted: #f1f5f9;\\n  --ui-text: #0f172a;\\n  --ui-text-muted: #475569;\\n  --ui-border-subtle: #e2e8f0;\\n  --ui-border: #cbd5e1;\\n  --ui-border-strong: #94a3b8;\\n  --ui-border-stronger: #64748b;\\n  --ui-primary: #1d4ed8;\\n  --ui-primary-contrast: #ffffff;\\n  --ui-module-reception: #0f766e;\\n  --ui-module-patients: #7c3aed;\\n  --ui-module-charts: var(--ui-primary);\\n  --ui-selection-bg: rgba(29, 78, 216, 0.08);\\n  --ui-selection-border: rgba(29, 78, 216, 0.35);\\n  --ui-shadow: 0 10px 32px rgba(15, 23, 42, 0.08);\\n  --ui-shadow-soft: 0 8px 24px rgba(15, 23, 42, 0.06);\\n  --ui-info-bg: #eff6ff;\\n  --ui-info-border: #93c5fd;\\n  --ui-info-text: #1e40af;\\n  --ui-success-bg: #ecfdf5;\\n  --ui-success-border: #86efac;\\n  --ui-success-text: #047857;\\n  --ui-warning-bg: #fff7ed;\\n  --ui-warning-border: #fcd34d;\\n  --ui-warning-text: #92400e;\\n  --ui-warning-strong: #7c2d12;\\n  --ui-error-bg: #fef2f2;\\n  --ui-error-border: #fca5a5;\\n  --ui-error-text: #991b1b;\\n  --ui-focus-ring: rgba(37, 99, 235, 0.55);\\n  --ui-focus-shadow: 0 0 0 3px rgba(59, 130, 246, 0.35);\\n}\\n\\nhtml {\\n  font-size: var(--ui-base-font-size);\\n  -webkit-text-size-adjust: 100%;\\n}\\n\\n@media (min-width: 1280px) and (min-height: 760px) {\\n  :root {\\n    --ui-base-font-size: 16.8px;\\n  }\\n}\\n\\n@media (min-width: 1600px) and (min-height: 900px) {\\n  :root {\\n    --ui-base-font-size: 17.2px;\\n  }\\n}\\n\\n* {\\n  box-sizing: border-box;\\n}\\n\\nbody {\\n  margin: 0;\\n  min-height: 100vh;\\n  overflow-x: hidden;\\n  background: var(--ui-bg);\\n  color: var(--ui-text);\\n}\\n\\n::selection {\\n  background: var(--ui-selection-bg);\\n}\\n\\n::-moz-selection {\\n  background: var(--ui-selection-bg);\\n}\\n\\n:where(a, button, input, select, textarea, summary, [role='button'], [tabindex]):focus-visible {\\n  outline: 3px solid var(--ui-focus-ring);\\n  outline-offset: 2px;\\n}\\n\\n.skip-link {\\n  position: absolute;\\n  top: 0.75rem;\\n  left: 0.75rem;\\n  z-index: 10000;\\n  padding: 0.6rem 0.85rem;\\n  border-radius: 12px;\\n  border: 2px solid #2563eb;\\n  background: #ffffff;\\n  color: #0f172a;\\n  text-decoration: none;\\n  transform: translateY(-200%);\\n  transition: transform 120ms ease;\\n}\\n\\n.skip-link:focus-visible {\\n  transform: translateY(0);\\n  outline: 3px solid rgba(37, 99, 235, 0.35);\\n  outline-offset: 2px;\\n}\\n\\n.skip-link + .skip-link {\\n  top: 3.4rem;\\n}\\n\\n/* FocusTrapDialog (modal) */\\n.focus-trap-dialog__backdrop {\\n  position: fixed;\\n  inset: 0;\\n  z-index: 11000;\\n  background: rgba(15, 23, 42, 0.55);\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  padding: 1.25rem;\\n}\\n\\n.focus-trap-dialog__panel {\\n  width: min(720px, 100%);\\n  max-height: 92vh;\\n  overflow: auto;\\n  background: #ffffff;\\n  border-radius: 20px;\\n  border: 1px solid var(--ui-border);\\n  box-shadow: 0 20px 70px rgba(15, 23, 42, 0.25);\\n  padding: 1.25rem;\\n}\\n\\n.focus-trap-dialog__header {\\n  display: flex;\\n  align-items: flex-start;\\n  justify-content: space-between;\\n  gap: 0.75rem;\\n}\\n\\n.focus-trap-dialog__title {\\n  margin: 0;\\n  font-size: 1.2rem;\\n  color: #0f172a;\\n}\\n\\n.focus-trap-dialog__close {\\n  border: none;\\n  background: transparent;\\n  cursor: pointer;\\n  color: #334155;\\n  font-size: 1.65rem;\\n  line-height: 1;\\n  padding: 0.25rem;\\n  border-radius: 12px;\\n  flex-shrink: 0;\\n}\\n\\n.focus-trap-dialog__close:hover {\\n  color: #0f172a;\\n  background: rgba(226, 232, 240, 0.7);\\n}\\n\\n.focus-trap-dialog__close:focus-visible {\\n  outline: 3px solid rgba(37, 99, 235, 0.45);\\n  outline-offset: 2px;\\n}\\n\\n.focus-trap-dialog__description {\\n  margin: 0.6rem 0 0;\\n  color: #475569;\\n  line-height: 1.6;\\n}\\n\\n.focus-trap-dialog__content {\\n  margin-top: 1rem;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.75rem;\\n}\\n\\n/* Full Screen Split Layout */\\n.login-shell {\\n  min-height: 100vh;\\n  display: flex;\\n  padding: 0;\\n  background: white;\\n}\\n\\n/* The container becomes the grid wrapper */\\n.login-card {\\n  width: 100%;\\n  min-height: 100vh;\\n  display: grid;\\n  grid-template-columns: 1.2fr 1fr;\\n  background: transparent;\\n  border-radius: 0;\\n  box-shadow: none;\\n  border: none;\\n  padding: 0;\\n}\\n\\n.login-card__title {\\n  position: absolute;\\n  width: 1px;\\n  height: 1px;\\n  padding: 0;\\n  margin: -1px;\\n  overflow: hidden;\\n  clip: rect(0, 0, 0, 0);\\n  white-space: nowrap;\\n  border: 0;\\n}\\n\\n/* Left Side: Visuals & Branding */\\n.login-card__header {\\n  position: relative;\\n  background: #ffffff;\\n  display: flex;\\n  flex-direction: column;\\n  justify-content: center;\\n  align-items: center;\\n  padding: 0;\\n  /* Remove padding to allow full-bleed image */\\n  color: #0f172a;\\n  overflow: hidden;\\n  gap: 0;\\n  border-right: 1px solid #f1f5f9;\\n}\\n\\n/* Abstract Background Shapes - lighter for white bg */\\n.login-card__header::before {\\n  content: '';\\n  position: absolute;\\n  top: -20%;\\n  left: -20%;\\n  width: 80%;\\n  height: 80%;\\n  background: radial-gradient(circle, rgba(79, 70, 229, 0.05) 0%, transparent 70%);\\n  border-radius: 50%;\\n  filter: blur(60px);\\n}\\n\\n.login-card__header::after {\\n  content: '';\\n  position: absolute;\\n  bottom: -10%;\\n  right: -10%;\\n  width: 70%;\\n  height: 70%;\\n  background: radial-gradient(circle, rgba(56, 189, 248, 0.05) 0%, transparent 60%);\\n  border-radius: 50%;\\n  filter: blur(40px);\\n}\\n\\n/* Branding Container */\\n.login-brand {\\n  position: relative;\\n  z-index: 10;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  width: 100%;\\n  height: 100%;\\n}\\n\\n.login-brand__badge {\\n  width: 100%;\\n  height: 100%;\\n  max-width: none;\\n  /* Allow full expansion */\\n  background: transparent;\\n  border: none;\\n  padding: 2rem;\\n  /* Keep a little padding so logo doesn't touch the absolute edge, or make it 0 for full bleed? \\\"全体を表示\\\" usually implies safe area or full. Let's give it slight breathing room (2rem) inside the full container. */\\n  box-shadow: none;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  flex: 1;\\n}\\n\\n.login-brand__badge img {\\n  width: 100%;\\n  height: 100%;\\n  object-fit: contain;\\n  /* Shows the whole image respecting aspect ratio */\\n}\\n\\n.login-brand__text {\\n  text-align: center;\\n  color: #0f172a;\\n  margin-bottom: 2rem;\\n  /* Give some space from bottom */\\n}\\n\\n.login-brand__eyebrow {\\n  color: #4f46e5;\\n  font-size: 0.875rem;\\n  letter-spacing: 0.2em;\\n  margin-bottom: 0.5rem;\\n  font-weight: 700;\\n}\\n\\n.login-card__header h1 {\\n  font-size: 3rem;\\n  background: linear-gradient(to right, #0f172a, #334155);\\n  -webkit-background-clip: text;\\n  -webkit-text-fill-color: transparent;\\n  margin: 0;\\n  line-height: 1.1;\\n  letter-spacing: -0.03em;\\n}\\n\\n.login-brand__sub {\\n  color: #64748b;\\n  font-weight: 500;\\n  font-size: 1.1rem;\\n  margin-top: 1rem;\\n}\\n\\n/* Right Side: Form */\\n.login-form {\\n  display: flex;\\n  flex-direction: column;\\n  justify-content: center;\\n  padding: 4rem 6rem;\\n  gap: 1.75rem;\\n  background: var(--ui-bg);\\n  /* Subtle cool gray to distinguish from the white left panel */\\n  position: relative;\\n  border-left: 1px solid var(--ui-border);\\n}\\n\\n/* Ensure the form content is centered vertically but not too spread out */\\n.login-form>* {\\n  max-width: 420px;\\n  width: 100%;\\n  margin-inline: auto;\\n}\\n\\n.field {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.5rem;\\n}\\n\\n.field span {\\n  font-size: 0.85rem;\\n  font-weight: 600;\\n  color: var(--ui-text-muted);\\n  /* Lighter, more elegant text color */\\n  margin-left: 2px;\\n  letter-spacing: 0.02em;\\n}\\n\\n.field input {\\n  font-family: var(--ui-font-sans);\\n  width: 100%;\\n  min-height: 40px;\\n  padding: 0.65rem 0.9rem;\\n  font-size: 1rem;\\n  border-radius: 8px;\\n  border: 1px solid var(--ui-border);\\n  background: var(--ui-surface);\\n  /* pure white inputs on the gray bg */\\n  color: var(--ui-text);\\n  transition: border-color 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease;\\n}\\n\\n.field input:focus {\\n  outline: none;\\n  background: var(--ui-surface);\\n  border-color: var(--ui-primary);\\n  box-shadow: var(--ui-focus-shadow);\\n}\\n\\n.field input::placeholder {\\n  color: #94a3b8;\\n}\\n\\n.field-error {\\n  color: #ef4444;\\n  font-size: 0.85rem;\\n  font-weight: 500;\\n  margin-left: 4px;\\n}\\n\\n.login-form__actions {\\n  margin-top: 1.5rem;\\n}\\n\\n.login-form__actions button {\\n  width: 100%;\\n  min-height: 40px;\\n  padding: 0.65rem 1rem;\\n  font-size: 1rem;\\n  font-weight: 700;\\n  border-radius: 8px;\\n  border: 1px solid var(--ui-primary);\\n  background: var(--ui-primary);\\n  color: var(--ui-primary-contrast);\\n  cursor: pointer;\\n  transition: transform 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;\\n  box-shadow: 0 8px 18px -10px rgba(29, 78, 216, 0.45);\\n  letter-spacing: 0.02em;\\n}\\n\\n.login-form__actions button:hover:not(:disabled) {\\n  transform: translateY(-1px);\\n  background: #1e40af;\\n  border-color: #1e40af;\\n  box-shadow: 0 14px 24px -12px rgba(29, 78, 216, 0.55);\\n}\\n\\n.login-form__actions button:disabled {\\n  background: #cbd5e1;\\n  border-color: #94a3b8;\\n  color: #64748b;\\n  cursor: default;\\n  transform: none;\\n  box-shadow: none;\\n}\\n\\n.login-form__actions button + button {\\n  background: var(--ui-surface);\\n  color: var(--ui-text);\\n  border-color: var(--ui-border);\\n  box-shadow: none;\\n}\\n\\n.login-form__actions button + button:hover:not(:disabled) {\\n  transform: none;\\n  background: var(--ui-surface-muted);\\n  border-color: var(--ui-border-strong);\\n  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.08);\\n}\\n\\n/* Status Messages */\\n.status-message {\\n  padding: 1rem;\\n  border-radius: 12px;\\n  background: #fffbeb;\\n  color: #92400e;\\n  font-size: 0.9rem;\\n  border: 1px solid #fcd34d;\\n  animation: slideUp 0.3s ease-out;\\n}\\n\\n.status-message.is-error {\\n  background: #fef2f2;\\n  border-color: #fca5a5;\\n  color: #991b1b;\\n}\\n\\n.status-message.is-success {\\n  background: #f0fdf4;\\n  border-color: #86efac;\\n  color: #166534;\\n}\\n\\n.login-card__header .status-message,\\n.login-form .status-message {\\n  width: min(100%, 420px);\\n}\\n\\n.status-message--step {\\n  background: #ffffff;\\n  border-color: #dbeafe;\\n  color: var(--ui-text);\\n}\\n\\n.status-message--destination {\\n  background: #f8fafc;\\n  border-color: var(--ui-border-subtle);\\n  color: var(--ui-text-muted);\\n}\\n\\n.status-message--quiet {\\n  background: #ffffff;\\n  border-color: var(--ui-border);\\n  color: var(--ui-text);\\n}\\n\\n.status-message--feedback {\\n  width: min(100%, 420px);\\n}\\n\\n.status-message__detail {\\n  margin: 0.35rem 0 0;\\n  line-height: 1.55;\\n  color: inherit;\\n}\\n\\n@keyframes slideUp {\\n  from {\\n    opacity: 0;\\n    transform: translateY(10px);\\n  }\\n\\n  to {\\n    opacity: 1;\\n    transform: translateY(0);\\n  }\\n}\\n\\n/* Facility Entry Overrides (Reused classes from LoginScreen logic) */\\n.facility-entry__block {\\n  max-width: 420px;\\n  margin: 1rem auto 0;\\n  width: 100%;\\n}\\n\\n.facility-entry__choices {\\n  justify-content: flex-start;\\n}\\n\\n@media (prefers-reduced-motion: reduce) {\\n  html:focus-within {\\n    scroll-behavior: auto;\\n  }\\n\\n  *,\\n  *::before,\\n  *::after {\\n    animation-duration: 0.01ms !important;\\n    animation-iteration-count: 1 !important;\\n    transition-duration: 0.01ms !important;\\n    scroll-behavior: auto !important;\\n  }\\n}\\n\\n/* Responsive */\\n@media (max-width: 960px) {\\n  .login-card {\\n    grid-template-columns: 1fr;\\n    grid-template-rows: auto 1fr;\\n  }\\n\\n  .login-card__header {\\n    padding: 3rem 2rem;\\n    min-height: 300px;\\n  }\\n\\n  .login-brand__badge {\\n    width: 100px;\\n    height: 100px;\\n    padding: 16px;\\n  }\\n\\n  .login-card__header h1 {\\n    font-size: 2.25rem;\\n  }\\n\\n  .login-form {\\n    padding: 2rem;\\n  }\\n}\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
