border-radius: 10px;\\n  border: 1px solid var(--ui-warning-border);\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  padding: 0.6rem 0.75rem;\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.6rem;\\n  font-size: 0.9rem;\\n}\\n\\n.patients-page__list-alert strong {\\n  font-weight: 800;\\n}\\n\\n.patients-page__list-alert.is-blocked {\\n  border-color: var(--ui-error-border);\\n  background: var(--ui-error-bg);\\n  color: var(--ui-error-text);\\n}\\n\\n.patients-page__row {\\n  border: 1px solid rgba(148, 163, 184, 0.16);\\n  background: rgba(255, 255, 255, 0.96);\\n  border-radius: var(--ui-radius-md);\\n  padding: 0.75rem;\\n  text-align: left;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.35rem;\\n  cursor: pointer;\\n  transition: background-color 0.2s ease, border-color 0.2s ease;\\n}\\n\\n.patients-page__row:hover {\\n  background: rgba(248, 250, 252, 0.96);\\n  border-color: rgba(37, 99, 235, 0.22);\\n}\\n\\n.patients-page__row.is-selected {\\n  border-color: var(--ui-selected-border);\\n  background: var(--ui-selected-bg);\\n  box-shadow: inset 3px 0 0 var(--ui-selected-rail);\\n}\\n\\n.patients-page__row.is-unlinked {\\n  border-color: var(--ui-warning-border);\\n  box-shadow: none;\\n}\\n\\n.patients-page__row-main {\\n  display: flex;\\n  align-items: baseline;\\n  gap: 0.5rem;\\n  flex-wrap: wrap;\\n}\\n\\n.patients-page__row.is-selected .patients-page__row-name-main {\\n  font-weight: 800;\\n  color: var(--ui-text);\\n}\\n\\n.patients-page__row.is-selected .patients-page__row-kana {\\n  color: var(--ui-text-muted);\\n}\\n\\n.patients-page__row-id {\\n  display: inline-flex;\\n  align-items: baseline;\\n  gap: 0.35rem;\\n  flex-wrap: wrap;\\n  padding: 0.2rem 0.55rem;\\n  border-radius: var(--ui-radius-md);\\n  border: 1px solid var(--ui-border-subtle);\\n  background: var(--ui-surface-muted);\\n  color: var(--ui-text-muted);\\n  font-size: 0.78rem;\\n  font-weight: 700;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.patients-page__row-id-label {\\n  color: var(--ui-text-muted);\\n  letter-spacing: 0.02em;\\n}\\n\\n.patients-page__row-id-value {\\n  color: var(--ui-text);\\n  font-weight: 800;\\n}\\n\\n.patients-page__badge {\\n  font-size: 0.85rem;\\n}\\n\\n.patients-page__row-kana {\\n  color: #64748b;\\n}\\n\\n.patients-page__row-warning {\\n  background: var(--ui-warning-bg);\\n  color: var(--ui-warning-text);\\n  padding: 0.2rem 0.55rem;\\n  border-radius: var(--ui-radius-md);\\n  font-size: 0.75rem;\\n  font-weight: 800;\\n}\\n\\n.patients-page__row-warning.is-blocked {\\n  background: var(--ui-error-bg);\\n  color: var(--ui-error-text);\\n}\\n\\n.patients-page__row-meta {\\n  display: flex;\\n  gap: 0.6rem;\\n  flex-wrap: wrap;\\n  font-size: 0.9rem;\\n  color: #475569;\\n}\\n\\n.patients-page__row-warning-detail {\\n  color: var(--ui-warning-strong);\\n  font-weight: 700;\\n}\\n\\n.patients-page__row-warning-detail.is-blocked {\\n  color: var(--ui-error-text);\\n}\\n\\n.patients-page__empty {\\n  margin: 0.5rem 0;\\n  color: #475569;\\n}\\n\\n.patients-page__empty-title {\\n  display: block;\\n  font-weight: 800;\\n  color: #0f172a;\\n}\\n\\n.patients-page__empty-body {\\n  display: block;\\n  margin-top: 0.2rem;\\n}\\n\\n.patients-page__empty-actions {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.5rem;\\n  margin-top: 0.5rem;\\n}\\n\\n.patients-page__empty-actions button {\\n  border: 1px solid rgba(148, 163, 184, 0.45);\\n  border-radius: 999px;\\n  padding: 0.4rem 0.7rem;\\n  cursor: pointer;\\n  background: #ffffff;\\n  color: #0f172a;\\n  font-weight: 700;\\n}\\n\\n.patients-page__empty-actions button:hover {\\n  background: #f8fafc;\\n}\\n\\n.patients-page__empty-hint {\\n  display: block;\\n  margin-top: 0.35rem;\\n  font-size: 0.85rem;\\n  color: #64748b;\\n}\\n\\n.patients-page__form {\\n  background: var(--ui-surface);\\n  border: 1px solid var(--ui-border);\\n  border-radius: 12px;\\n  padding: 1rem;\\n  display: flex;\\n  flex-direction: column;