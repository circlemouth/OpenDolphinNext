            "text": "import { MISSING_MASTER_RECOVERY_NEXT_ACTION } from \"/src/features/shared/missingMasterRecovery.ts\";\nexport function computeChartTone({ missingMaster, cacheHit, dataSourceTransition }) {\n  if (missingMaster) {\n    return dataSourceTransition === \"fallback\" ? \"error\" : \"warning\";\n  }\n  if (cacheHit) {\n    return \"info\";\n  }\n  if (dataSourceTransition === \"server\") {\n    return \"warning\";\n  }\n  if (dataSourceTransition === \"local\") {\n    return \"info\";\n  }\n  return \"info\";\n}\nconst TRANSITION_META = {\n  mock: {\n    label: \"dataSourceTransition=mock\",\n    tone: \"info\",\n    description: \"モック／デモ用データから取得中。診療判断には使わず server への切替を推奨。\",\n    reason: \"mock→server への移行待ち\"\n  },\n  snapshot: {\n    label: \"dataSourceTransition=snapshot\",\n    tone: \"warning\",\n    description: \"スナップショットキャッシュを参照中。マスタ欠損の可能性あり。\",\n    reason: \"server→snapshot （欠損検知時の暫定値）\"\n  },\n  server: {\n    label: \"dataSourceTransition=server\",\n    tone: \"warning\",\n    description: \"実 ORCA サーバーから取得中。欠損が解消したら tone=info へ戻ります。\",\n    reason: \"mock・snapshot→server （本値取得）\"\n  },\n  local: {\n    label: \"dataSourceTransition=local\",\n    tone: \"info\",\n    description: \"院内ローカル契約のデータを参照中。official ORCA bridge は使っていません。\",\n    reason: \"local contract（院内ローカル保存/参照）\"\n  },\n  fallback: {\n    label: \"dataSourceTransition=fallback\",\n    tone: \"error\",\n    description: \"フォールバックデータを利用中。計算は暫定、即時再取得が必要。\",\n    reason: \"server→fallback （master 欠損/通信失敗）\"\n  }\n};\nexport function getTransitionMeta(transition) {\n  return TRANSITION_META[transition];\n}\nexport function getTransitionCopy(transition) {\n  const meta = getTransitionMeta(transition);\n  return {\n    headline: meta.label,\n    body: `${meta.description} ｜ ${meta.reason}`,\n    meta\n  };\n}\nexport function isServerTransition(transition) {\n  return transition === \"server\";\n}\nexport function getChartToneDetails(payload) {\n  const tone = computeChartTone(payl