.DS_Store

# Temporary worktrees
.worktrees/

# Node / frontend dependencies (never commit)
node_modules/
**/node_modules/

# Common JS tool caches
**/.cache/
**/.vite/
**/.parcel-cache/
**/.turbo/
**/.eslintcache
**/.nyc_output/

# Maven build artifacts
**/target/

# Docker Compose runtime output
/docker/output/

# Environment overrides (samples stay tracked)
.env
.env.*
.env.local
.env.*.local
**/.env.local
**/.env.*.local
!.env.sample
orca.env.local
web-client/.env
web-client/.env.*
!web-client/.env.sample
!web-client/.env.stage.example
!web-client/.env.prod.example

# Local-only documentation with credentials
docs/web-client/operations/mac-dev-login.local.md
ops/tests/api-smoke-test/headers/javatime-stage.headers

# ORCA certification files
# Note: Pre-push hook (.git/hooks/pre-push) prevents pushing sensitive files to remote
# You can track these files locally with 'git add -f' if needed for worktree sharing
ORCAcertification/*.p12
ORCAcertification/*.pfx
ORCAcertification/*.key
ORCAcertification/*.pem
ORCAcertification/使用目的不明：使用停止/
ORCAcertification/新規*.txt
ORCAcertification/*パスワード*.txt
ORCAcertification/*アカウント情報*.txt
# README is tracked by default (no exclusion needed)

# Build artifacts and temporary files
build/
tmp/
output/
artifacts/source-archives/
# Generated review support packages and sidecar integrity summaries.
# Review ZIPs are local handoff artifacts; include source/log files via scripts/create-review-package.sh.
artifacts/reviewer-submission-packets/
artifacts/review-bundles/
artifacts/review-*.zip
artifacts/review-*.zip.*
# Local-only diagnostic fullflow/browser artifacts. Sanitized extracted summaries
# may be committed under docs/implementation, but raw screenshots/HAR/traces/
# videos/network dumps/request XML from diagnostic harnesses must remain ignored.
artifacts/diagnostic-fullflow/
artifacts/orca-remediation/closeout/*/qa/fullflow/
artifacts/orca-remediation/closeout/*/qa/diagnostic-fullflow/
artifacts/webclient/runtime-gate-ready/
artifacts/webclient/orca-e2e/
artifacts/webclient/e2e/
test-results/
playwright-report/
# RUN_ID-scoped local reviewer ZIP output under implementation packets.
docs/implementation/**/review-package/
docs/implementation/**/OpenDolphin_WebClient-review*.zip
docs/implementation/**/OpenDolphin_WebClient-review*.zip.*
web-client/tmp/
.playwright-cli/
artifacts/verification/
**/__MACOSX/
**/._*

# Server logs
server.log
server_*.log
server_*_logs.txt
*.log

# Temporary marker files
CACHED
fallback
/Phase2

# Temporary payload files in root
/payload.json
/common.zip
/server-modernized.zip

# Legacy build files (classic only). Keep root pom.xml for modernized builds.
/pom.server-classic.xml
/Jenkinsfile

# Generated dev config
custom.properties.dev
docker-compose.override.dev.yml
