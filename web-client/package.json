{
  "name": "web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stage": "VITE_DISABLE_MSW=1 vite --host --https --env-file .env.stage",
    "prebuild": "npm run verify:web-guard",
    "build": "tsc -b && vite build && npm run verify:prod-bundle-secrets && node scripts/prune-prod-artifacts.mjs",
    "prelint": "npm run verify:no-target-blank-unsafe",
    "pretest": "npm run verify:web-guard",
    "pretest:ci": "npm run verify:web-guard",
    "pretypecheck": "npm run verify:web-guard",
    "prune:prod-artifacts": "node scripts/prune-prod-artifacts.mjs",
    "verify:prod-no-mocks": "node scripts/verify-prod-dist-no-mocks.mjs",
    "verify:prod-bundle-secrets": "node scripts/verify-prod-bundle-secrets.mjs",
    "verify:no-public-secrets": "node scripts/verify-no-public-secrets.mjs",
    "verify:no-blocked-orca-route-strings": "node scripts/verify-no-blocked-orca-route-strings.mjs",
    "verify:no-direct-orca-proxy-config": "node scripts/verify-no-direct-orca-proxy-config.mjs",
    "verify:no-local-patient-mutation": "node scripts/verify-no-local-patient-mutation.mjs",
    "verify:no-legacy-auth-drift": "node scripts/verify-no-legacy-auth-drift.mjs",
    "verify:ui-mvp-contract": "node scripts/verify-ui-mvp-contract.mjs",
    "verify:medical-safety-ui-copy": "node scripts/verify-medical-safety-ui-copy.mjs",
    "verify:web-guard": "npm run verify:no-public-secrets && npm run verify:no-blocked-orca-route-strings && npm run verify:no-direct-orca-proxy-config && npm run verify:no-local-patient-mutation && npm run verify:no-legacy-auth-drift && npm run verify:ui-mvp-contract && npm run verify:medical-safety-ui-copy",
    "verify:no-target-blank-unsafe": "node scripts/verify-no-target-blank-unsafe.mjs",
    "lint": "eslint .",
    "openapi:orca-master": "node -e \"console.error('openapi:orca-master is retired; use docs/security-and-orca.md for the current ORCA boundary summary.'); process.exit(1)\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --silent --reporter=dot",
    "test:ci:shards": "node scripts/run-vitest-shards.mjs",
    "test:e2e:no-artifacts": "node scripts/run-safe-playwright-no-artifacts.mjs",
    "ci": "npm run verify:web-guard && npm run typecheck && npm run test:ci && npm run build",
    "test:watch": "vitest",
    "test:load": "tsx scripts/load-test.ts",
    "test:subpath-preview": "node scripts/verify-subpath-preview.mjs",
    "msw:init": "msw init public --save",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "bridge-sync": "node ../scripts/bridge-sync.mjs --run-id 20251124T073245Z --date 20251124 --source msw",
    "verify:source-integrity": "node scripts/verify-source-integrity.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-zone": "^2.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/instrumentation": "^0.208.0",
    "@opentelemetry/instrumentation-fetch": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@tanstack/react-virtual": "^3.13.13",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.13.1",
    "crypto-js": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.4",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/react": "^4.8.5",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-basic-ssl": "^1.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "4.0.5",
    "axe-core": "^4.10.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-storybook": "^0.8.0",
    "globals": "^16.4.0",
    "jsdom": "^24.1.3",
    "msw": "^2.11.6",
    "openapi-typescript": "^7.10.1",
    "storybook": "^8.6.14",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.0.11",
    "vitest": "4.0.5",
    "vitest-axe": "^1.0.0-pre.5",
    "web-vitals": "^4.2.4"
  }
}
